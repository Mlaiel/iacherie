# Production Environment Configuration 
# Copy from config/environments/.env.production.example
# 
# Ainflue Platform - Production Environment
# Author: Fahed Mlaiel (mlaiel@live.de)
# 
# ⚠️  SECURITY WARNING: Replace all CHANGE_ME values with secure keys
# ⚠️  NEVER commit this file with real production values to version control

# Application Settings
APP_NAME=Ainflue
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# API Configuration (Security hardened)
API_PREFIX=/api/v1
DOCS_URL=null
REDOC_URL=null

# CORS Configuration (Strict production domains)
CORS_ORIGINS=https://ainflue.com,https://www.ainflue.com,https://app.ainflue.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH

# Database Configuration (Production)
POSTGRES_HOST=ainflue-postgresql-cluster.postgres.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=ainflue_prod
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_DB=ainflue_platform_prod

# Redis Cache Database
REDIS_HOST=ainflue-redis-cluster.redis.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_PASSWORD
REDIS_DB=0

# Security Configuration (Production - MUST CHANGE)
JWT_SECRET_KEY=CHANGE_ME_TO_256_BIT_RANDOM_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
ENCRYPTION_KEY=CHANGE_ME_TO_256_BIT_ENCRYPTION_KEY_HERE

# Logging Configuration (Production)
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=https://your_sentry_dsn@sentry.io/production_project_id
SENTRY_ENVIRONMENT=production

# Performance Configuration (Production optimized)
CACHE_TTL=3600
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
REQUEST_TIMEOUT=30
WORKER_TIMEOUT=120

# Monitoring (Production)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Security Headers
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Feature Flags (Production)
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
AUTO_RELOAD=false
MOCK_EXTERNAL_CALLS=false

# Backup Configuration (Production)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=ainflue-backups-production

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# Compliance
GDPR_ENABLED=true
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=365