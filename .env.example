# Environment Configuration for Ainflue Platform
# Copy this file to .env and configure your values

# Application Settings
APP_NAME=Ainflue
APP_VERSION=1.0.0
APP_DESCRIPTION=AI-Powered Content Protection & Monetization Platform
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ainflue
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ainflue_platform

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=ainflue
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=ainflue_documents

# Security Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

ENCRYPTION_KEY=your_encryption_key_here_must_be_44_characters_base64
PASSWORD_SALT=your_password_salt_here

# OAuth2 Configuration (optional)
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_GITHUB_CLIENT_ID=your_github_client_id
OAUTH2_GITHUB_CLIENT_SECRET=your_github_client_secret

# AI Configuration
HUGGINGFACE_TOKEN=your_huggingface_token
OPENAI_API_KEY=your_openai_api_key
MAX_FILE_SIZE_MB=500
FAISS_INDEX_PATH=./data/faiss_indexes
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.85

# Platform API Keys
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

TIKTOK_API_KEY=your_tiktok_api_key
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Payment Configuration
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

WISE_API_KEY=your_wise_api_key
WISE_ENVIRONMENT=sandbox

# Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=ainflue-content
LOCAL_STORAGE_PATH=./storage
CDN_BASE_URL=https://cdn.youromain.com

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]