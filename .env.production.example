# Production Environment Configuration Template
# Copy this file to .env.production and fill in the actual values
# 
# Ainflue Platform - Production Environment
# Author: Fahed Mlaiel (mlaiel@live.de)
# Version: 1.0.0

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================

# Application Settings
APP_NAME=Ainflue
APP_VERSION=1.0.0
APP_DESCRIPTION="AI-Powered Content Protection & Monetization Platform"
ENVIRONMENT=production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_PREFIX=/api/v1
DOCS_URL=null
REDOC_URL=null

# CORS Configuration (restrict in production)
CORS_ORIGINS=https://ainflue.com,https://www.ainflue.com,https://app.ainflue.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# PostgreSQL Primary Database
POSTGRES_HOST=ainflue-postgresql-cluster.postgres.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=ainflue_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ainflue_platform_prod

# Redis Cache Database
REDIS_HOST=ainflue-redis-cluster.redis.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_DB=0

# MongoDB Document Database
MONGODB_HOST=ainflue-mongodb-cluster.mongodb.svc.cluster.local
MONGODB_PORT=27017
MONGODB_USER=ainflue_prod
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD_HERE
MONGODB_DB=ainflue_documents_prod

# =================================================================
# SECURITY CONFIGURATION
# =================================================================

# JWT Configuration (MUST CHANGE IN PRODUCTION)
JWT_SECRET_KEY=CHANGE_ME_TO_256_BIT_RANDOM_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

# Encryption Configuration (MUST CHANGE IN PRODUCTION)
ENCRYPTION_KEY=CHANGE_ME_TO_256_BIT_ENCRYPTION_KEY_HERE
PASSWORD_SALT=CHANGE_ME_TO_RANDOM_SALT_HERE

# OAuth2 Configuration
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
OAUTH2_GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
OAUTH2_GITHUB_CLIENT_ID=your_github_client_id
OAUTH2_GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# =================================================================
# AI & MACHINE LEARNING CONFIGURATION
# =================================================================

# AI Service Configuration
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Content Processing Limits
MAX_FILE_SIZE_MB=500
SUPPORTED_AUDIO_FORMATS=mp3,wav,flac,m4a,ogg
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif,bmp,tiff
SUPPORTED_TEXT_FORMATS=txt,md,doc,docx,pdf

# Vector Database Configuration
FAISS_INDEX_PATH=/app/data/faiss_indexes
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.85

# =================================================================
# PLATFORM INTEGRATIONS
# =================================================================

# YouTube Integration
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=CHANGE_ME_YOUTUBE_CLIENT_SECRET

# Instagram Integration
INSTAGRAM_ACCESS_TOKEN=IGQVJy_your_instagram_access_token_here
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=CHANGE_ME_INSTAGRAM_CLIENT_SECRET

# TikTok Integration
TIKTOK_API_KEY=your_tiktok_api_key_here
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=CHANGE_ME_TIKTOK_CLIENT_SECRET

# Spotify Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=CHANGE_ME_SPOTIFY_CLIENT_SECRET

# Twitter/X Integration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=CHANGE_ME_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=CHANGE_ME_TWITTER_ACCESS_SECRET

# =================================================================
# PAYMENT PROCESSING
# =================================================================

# Stripe Configuration (LIVE KEYS FOR PRODUCTION)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET_HERE

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_live_client_id
PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_CLIENT_SECRET_HERE
PAYPAL_ENVIRONMENT=live

# Wise Configuration
WISE_API_KEY=CHANGE_ME_WISE_API_KEY_HERE
WISE_ENVIRONMENT=live

# =================================================================
# CLOUD STORAGE
# =================================================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIA_your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=eu-central-1
AWS_S3_BUCKET=ainflue-content-production

# CDN Configuration
CDN_BASE_URL=https://cdn.ainflue.com

# Local Storage Fallback
LOCAL_STORAGE_PATH=/app/storage

# =================================================================
# MONITORING & OBSERVABILITY
# =================================================================

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry Configuration
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production

# =================================================================
# EMAIL & NOTIFICATIONS
# =================================================================

# SMTP Configuration
SMTP_HOST=smtp.ainflue.com
SMTP_PORT=587
SMTP_USERNAME=noreply@ainflue.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD_HERE
SMTP_USE_TLS=true

# Email Settings
FROM_EMAIL=noreply@ainflue.com
FROM_NAME=Ainflue Platform
ADMIN_EMAIL=mlaiel@live.de

# =================================================================
# SECURITY HEADERS & POLICIES
# =================================================================

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' https://js.stripe.com
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self' https://api.stripe.com

# Security Headers
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# =================================================================
# PERFORMANCE CONFIGURATION
# =================================================================

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30

# Request Timeout
REQUEST_TIMEOUT=30
WORKER_TIMEOUT=120

# =================================================================
# BACKUP & DISASTER RECOVERY
# =================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=ainflue-backups-production

# =================================================================
# COMPLIANCE & LEGAL
# =================================================================

# GDPR Compliance
GDPR_ENABLED=true
GDPR_RETENTION_DAYS=2555  # 7 years
GDPR_ANONYMIZATION_ENABLED=true

# Data Processing
DATA_PROCESSING_LOCATION=EU
DATA_RETENTION_DAYS=365
AUDIT_LOG_ENABLED=true

# =================================================================
# EXTERNAL SERVICES
# =================================================================

# Webhook Configuration
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_HERE
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_COUNT=3

# Third-party Integrations
ANALYTICS_ENABLED=true
EXTERNAL_API_TIMEOUT=10
API_RATE_LIMIT_ENABLED=true

# =================================================================
# DEPLOYMENT INFORMATION
# =================================================================

# Deployment Metadata
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_DATE=2025-01-15
DEPLOYED_BY=fahed-mlaiel
DEPLOYMENT_ENVIRONMENT=production

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
READINESS_CHECK_TIMEOUT=10
LIVENESS_CHECK_TIMEOUT=5

# =================================================================
# FEATURE FLAGS
# =================================================================

# Feature Toggles
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_MULTI_CURRENCY=true
FEATURE_COLLABORATION=true
FEATURE_ENTERPRISE_FEATURES=true

# Beta Features
BETA_VOICE_RECOGNITION=false
BETA_VIDEO_ANALYSIS=false
BETA_BLOCKCHAIN_INTEGRATION=false

# =================================================================
# MAINTENANCE MODE
# =================================================================

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Ainflue is temporarily unavailable for maintenance. We'll be back shortly."
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# =================================================================
# IMPORTANT SECURITY NOTES
# =================================================================

# WARNING: Replace all "CHANGE_ME_" values with secure, random keys
# Generate secure keys using: openssl rand -base64 32
# 
# For JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For PASSWORD_SALT: python -c "import secrets; print(secrets.token_urlsafe(16))"
#
# NEVER commit this file with real production values to version control!
# Use environment-specific secret management (Kubernetes secrets, AWS Secrets Manager, etc.)
#
# Contact: mlaiel@live.de for production deployment assistance
