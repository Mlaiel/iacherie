{
  "name": "ainflue-desktop",
  "version": "1.0.0",
  "description": "Ainflue Desktop - Advanced AI Content Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never"
  },
  "build": {
    "appId": "com.ainflue.desktop",
    "productName": "Ainflue Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "identity": "Developer ID Application: Fahed Mlaiel",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "mas",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "zip",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Fahed Mlaiel",
      "certificateFile": "build/certificate.p12",
      "certificatePassword": "${CSC_KEY_PASSWORD}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "snap",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Professional AI-powered content creation studio",
      "description": "Advanced content creation platform with AI processing capabilities, multi-monitor support, and professional editing tools."
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 100,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "default",
        "audio-playback",
        "audio-record",
        "camera",
        "home",
        "removable-media",
        "unity7"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "electron-store": "^8.1.0",
    "electron-log": "^5.0.1",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "node-fetch": "^3.3.2",
    "mime-types": "^2.1.35",
    "sharp": "^0.32.6",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9"
  },
  "author": "Fahed Mlaiel <mlaiel@live.de>",
  "license": "PROPRIETARY",
  "homepage": "https://ainflue.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mlaiel/Ainflue.git"
  },
  "keywords": [
    "ai",
    "content",
    "audio",
    "video",
    "editing",
    "studio",
    "desktop"
  ]
}