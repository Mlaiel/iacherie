"""
Tests for Quantum Random Number Generator Implementation

This module tests the quantum random number generation and entropy sources.
"""

import pytest
from backend.quantum.quantum_random_generator import (
    QuantumRandomGenerator,
    QuantumSource,
    TrueRandomSource,
    PhotonShotNoiseSource,
    QuantumTunnelingSource,
    EntropyQuality
)


class TestQuantumRandomGenerator:
    """Test main quantum random generator"""
    
    def test_qrng_initialization(self):
        """Test quantum random generator initialization"""
        qrng = QuantumRandomGenerator(pool_size=1000)
        
        status = qrng.get_entropy_status()
        
        assert status["total_entropy_available"] >= 0.0
        assert status["active_sources"] >= 0
        assert "pool_status" in status
        assert QuantumSource.PHOTON_SHOT_NOISE.value in status["pool_status"]
        assert QuantumSource.QUANTUM_TUNNELING.value in status["pool_status"]
    
    def test_entropy_collection(self):
        """Test entropy collection from quantum sources"""
        qrng = QuantumRandomGenerator(pool_size=500)
        
        # Collect entropy
        qrng.collect_entropy(source=QuantumSource.PHOTON_SHOT_NOISE, amount=50)
        
        status = qrng.get_entropy_status()
        
        # Should have collected some entropy
        assert status["total_entropy_available"] > 0.0
        photon_pool = status["pool_status"][QuantumSource.PHOTON_SHOT_NOISE.value]
        assert photon_pool["measurements_count"] > 0
        assert photon_pool["total_entropy"] > 0.0
    
    def test_random_bytes_generation(self):
        """Test quantum random bytes generation"""
        qrng = QuantumRandomGenerator()
        
        # Collect some entropy first
        qrng.collect_entropy(amount=100)
        
        # Generate random bytes
        random_bytes = qrng.generate_random_bytes(32, min_entropy_per_byte=6.0)
        
        assert len(random_bytes) == 32
        assert isinstance(random_bytes, bytes)
        
        # Generate different bytes should be different
        random_bytes2 = qrng.generate_random_bytes(32, min_entropy_per_byte=6.0)
        assert random_bytes != random_bytes2  # Extremely unlikely to be same
    
    def test_random_integer_generation(self):
        """Test quantum random integer generation"""
        qrng = QuantumRandomGenerator()
        
        # Collect entropy
        qrng.collect_entropy(amount=50)
        
        # Generate random integers
        random_int1 = qrng.generate_random_integer(0, 100)
        random_int2 = qrng.generate_random_integer(1000, 2000)
        
        assert 0 <= random_int1 <= 100
        assert 1000 <= random_int2 <= 2000
        assert isinstance(random_int1, int)
        assert isinstance(random_int2, int)
    
    def test_random_float_generation(self):
        """Test quantum random float generation"""
        qrng = QuantumRandomGenerator()
        
        # Collect entropy
        qrng.collect_entropy(amount=30)
        
        # Generate random floats
        random_float1 = qrng.generate_random_float()
        random_float2 = qrng.generate_random_float()
        
        assert 0.0 <= random_float1 < 1.0
        assert 0.0 <= random_float2 < 1.0
        assert isinstance(random_float1, float)
        assert isinstance(random_float2, float)
        assert random_float1 != random_float2  # Extremely unlikely to be same
    
    def test_randomness_testing(self):
        """Test statistical randomness tests"""
        qrng = QuantumRandomGenerator()
        
        # Collect substantial entropy for testing
        qrng.collect_entropy(amount=200)
        
        # Run randomness tests on smaller sample for speed
        tests = qrng.test_randomness(sample_size=1000)
        
        assert len(tests) > 0
        
        # Check test structure
        for test in tests:
            assert hasattr(test, 'test_name')
            assert hasattr(test, 'p_value')
            assert hasattr(test, 'passed')
            assert hasattr(test, 'sample_size')
            assert test.sample_size > 0
    
    def test_source_calibration(self):
        """Test quantum source calibration"""
        qrng = QuantumRandomGenerator()
        
        calibration_results = qrng.calibrate_all_sources()
        
        assert QuantumSource.PHOTON_SHOT_NOISE.value in calibration_results
        assert QuantumSource.QUANTUM_TUNNELING.value in calibration_results
        
        # Check calibration success
        for source_name, result in calibration_results.items():
            assert "success" in result
            if result["success"]:
                assert "result" in result


class TestPhotonShotNoiseSource:
    """Test photon shot noise entropy source"""
    
    def test_source_initialization(self):
        """Test photon source initialization"""
        source = PhotonShotNoiseSource()
        
        assert source.source_type == QuantumSource.PHOTON_SHOT_NOISE
        assert source.entropy_rate > 0.9  # High entropy rate
        assert source.detector_efficiency > 0.8
        
        health = source.get_health_status()
        assert health["source_type"] == QuantumSource.PHOTON_SHOT_NOISE.value
        assert health["entropy_rate"] > 0.9
    
    def test_entropy_collection(self):
        """Test photon entropy collection"""
        source = PhotonShotNoiseSource()
        
        measurements = source.collect_entropy(10)
        
        assert len(measurements) == 10
        for measurement in measurements:
            assert measurement.source == QuantumSource.PHOTON_SHOT_NOISE
            assert 0 <= measurement.raw_value <= 255
            assert measurement.entropy_estimate > 0.0
            assert measurement.confidence > 0.9
            assert "photon_count" in measurement.metadata
    
    def test_source_calibration(self):
        """Test photon source calibration"""
        source = PhotonShotNoiseSource()
        
        calibration = source.calibrate()
        
        assert "mean_photon_count" in calibration
        assert "detector_efficiency" in calibration
        assert "calibration_successful" in calibration
        assert source.is_active


class TestQuantumTunnelingSource:
    """Test quantum tunneling entropy source"""
    
    def test_source_initialization(self):
        """Test tunneling source initialization"""
        source = QuantumTunnelingSource()
        
        assert source.source_type == QuantumSource.QUANTUM_TUNNELING
        assert source.entropy_rate > 0.95  # Very high entropy rate
        assert source.barrier_height > 0.0
        assert source.temperature > 0.0
    
    def test_entropy_collection(self):
        """Test tunneling entropy collection"""
        source = QuantumTunnelingSource()
        
        measurements = source.collect_entropy(5)
        
        assert len(measurements) == 5
        for measurement in measurements:
            assert measurement.source == QuantumSource.QUANTUM_TUNNELING
            assert 0 <= measurement.raw_value <= 255
            assert measurement.entropy_estimate > 0.0
            assert measurement.confidence > 0.95
            assert "tunneling_events" in measurement.metadata
            assert "tunneling_probability" in measurement.metadata
    
    def test_source_calibration(self):
        """Test tunneling source calibration"""
        source = QuantumTunnelingSource()
        
        calibration = source.calibrate()
        
        assert "barrier_height" in calibration
        assert "temperature" in calibration
        assert "expected_entropy_rate" in calibration
        assert source.is_active


class TestQuantumRandomGeneratorIntegration:
    """Integration tests for complete quantum random system"""
    
    def test_multi_source_entropy_collection(self):
        """Test collecting entropy from multiple sources"""
        qrng = QuantumRandomGenerator()
        
        # Collect from all sources
        qrng.collect_entropy(amount=50)
        
        status = qrng.get_entropy_status()
        
        # Should have entropy from multiple sources
        active_pools = [pool for pool in status["pool_status"].values() 
                       if pool["measurements_count"] > 0]
        assert len(active_pools) >= 1
        assert status["total_entropy_available"] > 0.0
    
    def test_insufficient_entropy_handling(self):
        """Test handling of insufficient entropy scenarios"""
        qrng = QuantumRandomGenerator(pool_size=100)
        
        # Try to generate more randomness than available
        # Should automatically collect more entropy
        random_bytes = qrng.generate_random_bytes(16, min_entropy_per_byte=7.5)
        
        assert len(random_bytes) == 16
        assert isinstance(random_bytes, bytes)
    
    def test_entropy_quality_assessment(self):
        """Test entropy quality assessment"""
        qrng = QuantumRandomGenerator()
        
        # Collect entropy
        qrng.collect_entropy(amount=100)
        
        status = qrng.get_entropy_status()
        
        # Check that entropy quality is assessed
        for pool_status in status["pool_status"].values():
            assert "quality" in pool_status
            quality = pool_status["quality"]
            assert quality in [q.value for q in EntropyQuality]