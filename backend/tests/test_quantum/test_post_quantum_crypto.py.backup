"""
Tests for Post-Quantum Cryptography Implementation

This module tests the lattice-based encryption and post-quantum crypto functionality.
"""

import pytest
from backend.quantum.post_quantum_crypto import (
    PostQuantumCrypto, 
    LatticeBasedEncryption, 
    LatticeAlgorithm,
    LatticeKeyPair,
    QuantumEncryptionResult
)


class TestLatticeBasedEncryption:
    """Test lattice-based encryption functionality"""
    
    def test_keypair_generation(self):
        """Test quantum-resistant key pair generation"""
        crypto = LatticeBasedEncryption(LatticeAlgorithm.CRYSTALS_KYBER_768)
        keypair = crypto.generate_keypair()
        
        assert isinstance(keypair, LatticeKeyPair)
        assert keypair.algorithm == LatticeAlgorithm.CRYSTALS_KYBER_768
        assert keypair.security_level == 3
        assert len(keypair.public_key) == 1184
        assert len(keypair.private_key) == 1184
        assert keypair.metadata["quantum_security"] is True
    
    def test_key_encapsulation(self):
        """Test key encapsulation mechanism (KEM)"""
        crypto = LatticeBasedEncryption(LatticeAlgorithm.CRYSTALS_KYBER_512)
        keypair = crypto.generate_keypair()
        
        shared_secret, encapsulated_key = crypto.encapsulate(keypair)
        
        assert len(shared_secret) == 32  # 256-bit shared secret
        assert len(encapsulated_key) == 48  # 32 + 16 byte structure
        assert isinstance(shared_secret, bytes)
        assert isinstance(encapsulated_key, bytes)
    
    def test_key_decapsulation(self):
        """Test key decapsulation mechanism"""
        crypto = LatticeBasedEncryption(LatticeAlgorithm.CRYSTALS_KYBER_768)
        keypair = crypto.generate_keypair()
        
        shared_secret1, encapsulated_key = crypto.encapsulate(keypair)
        shared_secret2 = crypto.decapsulate(encapsulated_key, keypair)
        
        assert shared_secret1 == shared_secret2
        assert len(shared_secret2) == 32


class TestPostQuantumCrypto:
    """Test main post-quantum crypto interface"""
    
    def test_encryption_decryption(self):
        """Test quantum-resistant encryption and decryption"""
        pq_crypto = PostQuantumCrypto(LatticeAlgorithm.CRYSTALS_KYBER_768)
        
        # Generate key pair
        lattice_crypto = LatticeBasedEncryption(LatticeAlgorithm.CRYSTALS_KYBER_768)
        keypair = lattice_crypto.generate_keypair()
        
        # Test data
        plaintext = b"This is a test message for quantum-resistant encryption!"
        
        # Encrypt
        result = pq_crypto.encrypt(plaintext, keypair)
        
        assert isinstance(result, QuantumEncryptionResult)
        assert result.algorithm == LatticeAlgorithm.CRYSTALS_KYBER_768
        assert result.security_level == 3
        assert len(result.ciphertext) >= len(plaintext)
        assert result.metadata["quantum_resistant"] is True
        assert result.metadata["lattice_based"] is True
        
        # Decrypt
        decrypted = pq_crypto.decrypt(result, keypair)
        assert decrypted == plaintext
    
    def test_encryption_with_additional_data(self):
        """Test encryption with authenticated additional data"""
        pq_crypto = PostQuantumCrypto(LatticeAlgorithm.CRYSTALS_KYBER_512)
        lattice_crypto = LatticeBasedEncryption(LatticeAlgorithm.CRYSTALS_KYBER_512)
        keypair = lattice_crypto.generate_keypair()
        
        plaintext = b"Secret message"
        additional_data = b"Authenticated context data"
        
        # Encrypt with additional data
        result = pq_crypto.encrypt(plaintext, keypair, additional_data)
        
        # Decrypt with additional data
        decrypted = pq_crypto.decrypt(result, keypair, additional_data)
        assert decrypted == plaintext
        
        # Decryption should fail with wrong additional data
        with pytest.raises(ValueError):
            pq_crypto.decrypt(result, keypair, b"Wrong additional data")
    
    def test_tampered_ciphertext_detection(self):
        """Test detection of tampered ciphertext"""
        pq_crypto = PostQuantumCrypto()
        lattice_crypto = LatticeBasedEncryption()
        keypair = lattice_crypto.generate_keypair()
        
        plaintext = b"Original message"
        result = pq_crypto.encrypt(plaintext, keypair)
        
        # Tamper with ciphertext
        tampered_ciphertext = bytearray(result.ciphertext)
        tampered_ciphertext[0] ^= 0xFF  # Flip bits
        result.ciphertext = bytes(tampered_ciphertext)
        
        # Decryption should fail
        with pytest.raises(ValueError, match="MAC verification failed"):
            pq_crypto.decrypt(result, keypair)
    
    def test_supported_algorithms(self):
        """Test getting supported algorithms"""
        pq_crypto = PostQuantumCrypto()
        algorithms = pq_crypto.get_supported_algorithms()
        
        assert LatticeAlgorithm.CRYSTALS_KYBER_512 in algorithms
        assert LatticeAlgorithm.CRYSTALS_KYBER_768 in algorithms
        assert LatticeAlgorithm.CRYSTALS_KYBER_1024 in algorithms
        assert len(algorithms) >= 3
    
    def test_algorithm_info(self):
        """Test getting algorithm information"""
        pq_crypto = PostQuantumCrypto()
        
        info = pq_crypto.get_algorithm_info(LatticeAlgorithm.CRYSTALS_KYBER_768)
        
        assert info["algorithm"] == "crystals-kyber-768"
        assert info["security_level"] == 3
        assert info["key_size"] == 1184
        assert info["quantum_resistant"] is True
        assert info["lattice_based"] is True
        assert info["standardized"] is True
    
    def test_algorithm_benchmark(self):
        """Test algorithm performance benchmarking"""
        pq_crypto = PostQuantumCrypto()
        
        # Run a small benchmark
        benchmark = pq_crypto.benchmark_algorithm(LatticeAlgorithm.CRYSTALS_KYBER_512, iterations=5)
        
        assert "key_generation_time" in benchmark
        assert "kem_time" in benchmark
        assert "total_time" in benchmark
        assert benchmark["algorithm"] == "crystals-kyber-512"
        assert benchmark["iterations"] == 5
        assert benchmark["key_generation_time"] > 0
        assert benchmark["kem_time"] > 0
    
    def test_different_algorithms(self):
        """Test encryption with different quantum-resistant algorithms"""
        algorithms = [
            LatticeAlgorithm.CRYSTALS_KYBER_512,
            LatticeAlgorithm.CRYSTALS_KYBER_768,
            LatticeAlgorithm.CRYSTALS_KYBER_1024
        ]
        
        plaintext = b"Multi-algorithm test"
        
        for algorithm in algorithms:
            pq_crypto = PostQuantumCrypto(algorithm)
            lattice_crypto = LatticeBasedEncryption(algorithm)
            keypair = lattice_crypto.generate_keypair()
            
            # Test encryption/decryption
            result = pq_crypto.encrypt(plaintext, keypair)
            decrypted = pq_crypto.decrypt(result, keypair)
            
            assert decrypted == plaintext
            assert result.algorithm == algorithm