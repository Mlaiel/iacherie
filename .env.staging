# Staging Environment Configuration
# Copy from config/environments/.env.production.example and modify for staging
# 
# Ainflue Platform - Staging Environment
# Author: Fahed Mlaiel (mlaiel@live.de)

# Application Settings
APP_NAME=Ainflue-Staging
APP_VERSION=1.0.0-staging
ENVIRONMENT=staging
DEBUG=false
HOST=0.0.0.0
PORT=8000

# API Configuration
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Configuration (restrictive but allows staging domains)
CORS_ORIGINS=https://staging.ainflue.com,https://staging-app.ainflue.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH

# Database Configuration (Staging)
POSTGRES_HOST=staging-postgresql.postgres.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=ainflue_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=ainflue_platform_staging

# Redis Cache Database
REDIS_HOST=staging-redis.redis.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
REDIS_DB=0

# Security Configuration (Staging)
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET_KEY_256_BIT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
ENCRYPTION_KEY=CHANGE_ME_STAGING_ENCRYPTION_KEY_256_BIT

# Logging Configuration (Enhanced for staging)
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=https://your_sentry_dsn@sentry.io/staging_project_id
SENTRY_ENVIRONMENT=staging

# Performance Configuration
CACHE_TTL=1800
DB_POOL_SIZE=10
REQUEST_TIMEOUT=30

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Feature Flags (Test production features)
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
AUTO_RELOAD=false
MOCK_EXTERNAL_CALLS=false

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=ainflue-backups-staging