{
  "name": "Ainflue - AI-Powered Content Protection & Monetization",
  "short_name": "Ainflue",
  "description": "Complete content creator platform with AI protection, collaboration, and monetization",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#6366f1",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "business", "social", "entertainment"],
  
  "icons": [
    {
      "src": "/static/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/static/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Upload Content",
      "short_name": "Upload",
      "description": "Quick upload your content for AI protection",
      "url": "/upload",
      "icons": [{ "src": "/static/icons/upload-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Analytics Dashboard",
      "short_name": "Analytics",
      "description": "View your content performance metrics",
      "url": "/analytics",
      "icons": [{ "src": "/static/icons/analytics-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Collaborations",
      "short_name": "Collabs",
      "description": "Manage your active collaborations",
      "url": "/collaborations",
      "icons": [{ "src": "/static/icons/collab-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Revenue",
      "short_name": "Revenue",
      "description": "Track your monetization performance",
      "url": "/revenue",
      "icons": [{ "src": "/static/icons/revenue-96x96.png", "sizes": "96x96" }]
    }
  ],
  
  "screenshots": [
    {
      "src": "/static/screenshots/mobile-dashboard.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Dashboard view for content creators"
    },
    {
      "src": "/static/screenshots/mobile-upload.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Content upload with AI protection"
    },
    {
      "src": "/static/screenshots/desktop-analytics.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "platform": "wide",
      "label": "Advanced analytics dashboard"
    }
  ],
  
  "features": [
    "offline-capable",
    "camera-access",
    "microphone-access",
    "push-notifications",
    "background-sync",
    "file-upload",
    "biometric-auth"
  ],
  
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ainflue.app",
      "id": "com.ainflue.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/ainflue/id123456789",
      "id": "123456789"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/handle-file",
      "accept": {
        "audio/*": [".mp3", ".wav", ".m4a", ".ogg", ".flac"],
        "video/*": [".mp4", ".mov", ".avi", ".mkv", ".webm"],
        "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp"],
        "text/*": [".txt", ".md", ".doc", ".docx", ".pdf"],
        "application/json": [".json"]
      }
    }
  ],
  
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["audio/*", "video/*", "image/*", "text/*"]
        }
      ]
    }
  },
  
  "protocol_handlers": [
    {
      "protocol": "ainflue",
      "url": "/handle-protocol?url=%s"
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}