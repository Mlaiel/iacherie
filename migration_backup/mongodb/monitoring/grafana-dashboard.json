{
  "dashboard": {
    "id": null,
    "title": "MongoDB Enterprise Dashboard - Ainflue Platform",
    "description": "Comprehensive MongoDB monitoring for enterprise production environments",
    "tags": ["mongodb", "ainflue", "enterprise"],
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(mongodb_up, environment)",
          "refresh": 1,
          "multi": false,
          "includeAll": false
        },
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(mongodb_up{environment=\"$environment\"}, instance)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "MongoDB Cluster Status",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "mongodb_up{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "unit": "short",
            "displayName": "Status"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal"
        }
      },
      {
        "id": 2,
        "title": "Connections",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "mongodb_connections_current{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Current"
          },
          {
            "expr": "mongodb_connections_available{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Available"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "Operations per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "rate(mongodb_op_counters_total{environment=\"$environment\", instance=~\"$instance\"}[5m])",
            "legendFormat": "{{type}} - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Operations/sec", "min": 0},
          {"show": false}
        ],
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "max": true,
          "avg": true
        }
      },
      {
        "id": 4,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "mongodb_memory_resident{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Resident - {{instance}}"
          },
          {
            "expr": "mongodb_memory_virtual{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Virtual - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Memory (MB)", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 5,
        "title": "Query Execution Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(mongodb_op_latencies_histogram_bucket{environment=\"$environment\", instance=~\"$instance\"}[5m]))",
            "legendFormat": "95th percentile - {{type}} - {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(mongodb_op_latencies_histogram_bucket{environment=\"$environment\", instance=~\"$instance\"}[5m]))",
            "legendFormat": "99th percentile - {{type}} - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Latency (ms)", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 6,
        "title": "Replica Set Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "mongodb_replset_member_health{environment=\"$environment\", instance=~\"$instance\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true},
              "renameByName": {
                "instance": "Instance",
                "state": "State",
                "Value": "Health"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Database Storage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "mongodb_dbstats_dataSize{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Data Size - {{database}} - {{instance}}"
          },
          {
            "expr": "mongodb_dbstats_indexSize{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Index Size - {{database}} - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Size (Bytes)", "min": 0},
          {"show": false}
        ]
      },
      {
        "id": 8,
        "title": "Connection Pool Utilization",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "(mongodb_connections_current{environment=\"$environment\", instance=~\"$instance\"} / mongodb_connections_available{environment=\"$environment\", instance=~\"$instance\"}) * 100",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 60},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 9,
        "title": "Slow Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "rate(mongodb_metrics_operation_total{environment=\"$environment\", instance=~\"$instance\"}[5m])",
            "legendFormat": "{{type}} operations - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Operations/sec", "min": 0},
          {"show": false}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [100], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "10s",
          "handler": 1,
          "name": "High slow operations rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 10,
        "title": "Replication Lag",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38},
        "targets": [
          {
            "expr": "mongodb_replset_member_replication_lag{environment=\"$environment\", instance=~\"$instance\"}",
            "legendFormat": "Replication lag - {{instance}}"
          }
        ],
        "yAxes": [
          {"label": "Lag (seconds)", "min": 0},
          {"show": false}
        ],
        "thresholds": [
          {
            "value": 10,
            "colorMode": "critical",
            "op": "gt"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "enable": true,
          "iconColor": "blue",
          "query": "ALERTS{alertname=\"Deployment\"}",
          "titleFormat": "Deployment",
          "textFormat": "{{instance}}"
        }
      ]
    }
  }
}