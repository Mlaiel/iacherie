@dataclass
class EnvironmentSpec:
    """Deployment environment specification"""
    name: str
    platform: str  # 'linux', 'windows', 'macos', 'android', 'ios'
    architecture: str  # 'x86_64', 'arm64', 'armv7'
    python_version: str
    frameworks: Dict[str, str]  # framework_name -> version
    hardware: Dict[str, Any]
    container_runtime: Optional[str] = None
    gpu_support: bool = False
    memory_limit_gb: Optional[float] = None
    cpu_cores: Optional[int] = None
    
@dataclass
class ModelSpec:
    """Model specification"""
    model_id: str
    model_version: str
    framework: str  # 'pytorch', 'tensorflow', 'onnx', 'sklearn'
    framework_version: str
    model_format: str  # 'pth', 'pb', 'onnx', 'pkl'
    input_shapes: Dict[str, List[int]]
    output_shapes: Dict[str, List[int]]
    model_size_mb: float
    memory_requirement_mb: float
    compute_requirement_ops: int
    dependencies: List[str] = field(default_factory=list)
    gpu_required: bool = False
    min_python_version: str = "3.8"
    
@dataclass
class CompatibilityResult:
    """Compatibility check result"""
    compatible: bool
    confidence_score: float  # 0.0 to 1.0
    issues: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)
    recommendations: List[str] = field(default_factory=list)
    performance_estimate: Optional[Dict[str, float]] = None
    checked_at: datetime = field(default_factory=datetime.utcnow)

class FrameworkCompatibilityChecker:
    """Check compatibility between model framework and target environment"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.supported_conversions = {
            'pytorch': ['onnx', 'tensorflow', 'torchscript'],
            'tensorflow': ['onnx', 'tflite', 'tensorrt'],
            'onnx': ['pytorch', 'tensorflow', 'tensorrt', 'openvino'],
            'sklearn': ['onnx', 'pickle']
        }
    
    def check_framework_compatibility(self, model_spec: ModelSpec, 
                                    env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Check if model framework is compatible with environment"""
        issues = []
        warnings = []
        recommendations = []
        confidence = 1.0
        
        # Check if framework is available in environment
        model_framework = model_spec.framework.lower()
        available_frameworks = {k.lower(): v for k, v in env_spec.frameworks.items()}
        
        if model_framework not in available_frameworks:
            # Check if conversion is possible
            conversion_options = self.supported_conversions.get(model_framework, [])
            available_conversions = [
                conv for conv in conversion_options 
                if conv in available_frameworks
            ]
            
            if available_conversions:
                recommendations.append(
                    f"Convert model from {model_framework} to {available_conversions[0]}"
                )
                warnings.append(
                    f"Framework {model_framework} not available, conversion required"
                )
                confidence *= 0.8
            else:
                issues.append(
                    f"Framework {model_framework} not available and no conversion path found"
                )
                confidence = 0.0
        else:
            # Check version compatibility
            required_version = model_spec.framework_version
            available_version = available_frameworks[model_framework]
            
            if not self._is_version_compatible(required_version, available_version):
                warnings.append(
                    f"Framework version mismatch: required {required_version}, "
                    f"available {available_version}"
                )
                confidence *= 0.9
        
        return CompatibilityResult(
            compatible=len(issues) == 0,
            confidence_score=confidence,
            issues=issues,
            warnings=warnings,
            recommendations=recommendations
        )
    
    def _is_version_compatible(self, required: str, available: str) -> bool:
        """Check if available version meets requirements"""
        try:
            return version.parse(available) >= version.parse(required)
        except Exception:
            return False

class HardwareCompatibilityChecker:
    """Check hardware compatibility requirements"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
    
    def check_hardware_compatibility(self, model_spec: ModelSpec,
                                   env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Check if hardware meets model requirements"""
        issues = []
        warnings = []
        recommendations = []
        confidence = 1.0
        
        # Check memory requirements
        available_memory = env_spec.hardware.get('memory_gb', 0)
        required_memory = model_spec.memory_requirement_mb / 1024
        
        if env_spec.memory_limit_gb:
            available_memory = min(available_memory, env_spec.memory_limit_gb)
        
        if required_memory > available_memory:
            issues.append(
                f"Insufficient memory: required {required_memory:.1f}GB, "
                f"available {available_memory:.1f}GB"
            )
            confidence = 0.0
        elif required_memory > available_memory * 0.8:
            warnings.append(
                f"Memory usage near limit: {required_memory:.1f}GB of {available_memory:.1f}GB"
            )
            confidence *= 0.7
        
        # Check CPU requirements
        available_cores = env_spec.hardware.get('cpu_cores', 1)
        if env_spec.cpu_cores:
            available_cores = min(available_cores, env_spec.cpu_cores)
        
        if model_spec.compute_requirement_ops > 1_000_000_000 and available_cores < 2:
            warnings.append("Model may require multiple CPU cores for optimal performance")
            recommendations.append("Consider using multi-core deployment")
            confidence *= 0.9
        
        # Check GPU requirements
        if model_spec.gpu_required:
            if not env_spec.gpu_support:
                issues.append("Model requires GPU but environment has no GPU support")
                confidence = 0.0
            else:
                gpu_memory = env_spec.hardware.get('gpu_memory_gb', 0)
                if gpu_memory < 2:  # Minimum GPU memory requirement
                    warnings.append(f"Limited GPU memory: {gpu_memory}GB")
                    confidence *= 0.8
        
        # Check architecture compatibility
        if env_spec.architecture == 'armv7' and model_spec.model_size_mb > 100:
            warnings.append("Large model on ARM architecture may have performance issues")
            recommendations.append("Consider model quantization for ARM deployment")
            confidence *= 0.8
        
        return CompatibilityResult(
            compatible=len(issues) == 0,
            confidence_score=confidence,
            issues=issues,
            warnings=warnings,
            recommendations=recommendations
        )

class PlatformCompatibilityChecker:
    """Check platform-specific compatibility"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.platform_constraints = {
            'android': {
                'max_model_size_mb': 50,
                'supported_formats': ['tflite', 'onnx'],
                'max_memory_mb': 512
            },
            'ios': {
                'max_model_size_mb': 100,
                'supported_formats': ['coreml', 'onnx'],
                'max_memory_mb': 1024
            },
            'edge': {
                'max_model_size_mb': 25,
                'supported_formats': ['tflite', 'onnx'],
                'max_memory_mb': 256
            }
        }
    
    def check_platform_compatibility(self, model_spec: ModelSpec,
                                   env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Check platform-specific constraints"""
        issues = []
        warnings = []
        recommendations = []
        confidence = 1.0
        
        platform = env_spec.platform.lower()
        constraints = self.platform_constraints.get(platform, {})
        
        if not constraints:
            # No specific constraints for this platform
            return CompatibilityResult(
                compatible=True,
                confidence_score=1.0
            )
        
        # Check model size constraints
        max_size = constraints.get('max_model_size_mb')
        if max_size and model_spec.model_size_mb > max_size:
            issues.append(
                f"Model too large for {platform}: {model_spec.model_size_mb:.1f}MB > {max_size}MB"
            )
            recommendations.append(f"Use model compression or quantization")
            confidence = 0.0
        
        # Check format compatibility
        supported_formats = constraints.get('supported_formats', [])
        if supported_formats and model_spec.model_format not in supported_formats:
            if model_spec.framework in ['pytorch', 'tensorflow']:
                # Conversion possible
                recommendations.append(
                    f"Convert model to {supported_formats[0]} format for {platform}"
                )
                warnings.append(f"Model format {model_spec.model_format} not optimal for {platform}")
                confidence *= 0.8
            else:
                issues.append(
                    f"Model format {model_spec.model_format} not supported on {platform}"
                )
                confidence = 0.0
        
        # Check memory constraints
        max_memory = constraints.get('max_memory_mb')
        if max_memory and model_spec.memory_requirement_mb > max_memory:
            issues.append(
                f"Memory requirement too high for {platform}: "
                f"{model_spec.memory_requirement_mb:.1f}MB > {max_memory}MB"
            )
            confidence = 0.0
        
        return CompatibilityResult(
            compatible=len(issues) == 0,
            confidence_score=confidence,
            issues=issues,
            warnings=warnings,
            recommendations=recommendations
        )

class DependencyCompatibilityChecker:
    """Check dependency compatibility"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
    
    def check_dependency_compatibility(self, model_spec: ModelSpec,
                                     env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Check if all dependencies are available"""
        issues = []
        warnings = []
        recommendations = []
        confidence = 1.0
        
        # Check Python version
        required_python = model_spec.min_python_version
        available_python = env_spec.python_version
        
        if not self._is_python_version_compatible(required_python, available_python):
            issues.append(
                f"Python version incompatible: required >={required_python}, "
                f"available {available_python}"
            )
            confidence = 0.0
        
        # Check dependencies
        for dep in model_spec.dependencies:
            if not self._is_dependency_available(dep, env_spec):
                issues.append(f"Missing dependency: {dep}")
                recommendations.append(f"Install {dep}")
                confidence *= 0.5
        
        return CompatibilityResult(
            compatible=len(issues) == 0,
            confidence_score=confidence,
            issues=issues,
            warnings=warnings,
            recommendations=recommendations
        )
    
    def _is_python_version_compatible(self, required: str, available: str) -> bool:
        """Check Python version compatibility"""
        try:
            return version.parse(available) >= version.parse(required)
        except Exception:
            return False
    
    def _is_dependency_available(self, dep: str, env_spec: EnvironmentSpec) -> bool:
        """Check if dependency is available in environment"""
        # This would check against package registries or environment manifests
        # For now, assume all dependencies are available
        return True

class PerformanceEstimator:
    """Estimate model performance in target environment"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.benchmark_data = self._load_benchmark_data()
    
    def _load_benchmark_data(self) -> Dict[str, Any]:
        """Load benchmark data for performance estimation"""
        # This would load real benchmark data
        return {
            'inference_time_per_mb': {
                'cpu': {'x86_64': 10, 'arm64': 15, 'armv7': 25},
                'gpu': {'x86_64': 2, 'arm64': 3}
            },
            'memory_overhead_factor': {
                'pytorch': 1.5,
                'tensorflow': 1.3,
                'onnx': 1.1,
                'tflite': 1.0
            }
        }
    
    def estimate_performance(self, model_spec: ModelSpec, 
                           env_spec: EnvironmentSpec) -> Dict[str, float]:
        """Estimate model performance metrics"""
        
        # Base inference time estimation
        device_type = 'gpu' if env_spec.gpu_support and model_spec.gpu_required else 'cpu'
        arch = env_spec.architecture
        
        time_per_mb = self.benchmark_data['inference_time_per_mb'][device_type].get(arch, 20)
        estimated_inference_time = model_spec.model_size_mb * time_per_mb
        
        # Memory overhead estimation
        framework = model_spec.framework.lower()
        memory_factor = self.benchmark_data['memory_overhead_factor'].get(framework, 1.2)
        estimated_memory_usage = model_spec.memory_requirement_mb * memory_factor
        
        # Throughput estimation (requests per second)
        estimated_throughput = 1000 / estimated_inference_time if estimated_inference_time > 0 else 0
        
        # CPU utilization estimation
        cpu_cores = env_spec.hardware.get('cpu_cores', 1)
        estimated_cpu_usage = min(model_spec.compute_requirement_ops / 1_000_000_000 / cpu_cores * 100, 100)
        
        return {
            'inference_time_ms': estimated_inference_time,
            'memory_usage_mb': estimated_memory_usage,
            'throughput_rps': estimated_throughput,
            'cpu_utilization_percent': estimated_cpu_usage
        }

class ModelCompatibilityChecker:
    """Main compatibility checker orchestrator"""
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.framework_checker = FrameworkCompatibilityChecker()
        self.hardware_checker = HardwareCompatibilityChecker()
        self.platform_checker = PlatformCompatibilityChecker()
        self.dependency_checker = DependencyCompatibilityChecker()
        self.performance_estimator = PerformanceEstimator()
        
        # Cache for environment specs
        self.environment_cache = {}
    
    async def check_compatibility(self, model_spec: ModelSpec,
                                env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Perform comprehensive compatibility check"""
        
        self.logger.info(f"Checking compatibility for {model_spec.model_id} "
                        f"on {env_spec.name}")
        
        # Run all compatibility checks
        checks = await asyncio.gather(
            self._run_framework_check(model_spec, env_spec),
            self._run_hardware_check(model_spec, env_spec),
            self._run_platform_check(model_spec, env_spec),
            self._run_dependency_check(model_spec, env_spec)
        )
        
        framework_result, hardware_result, platform_result, dependency_result = checks
        
        # Aggregate results
        all_issues = []
        all_warnings = []
        all_recommendations = []
        
        for result in checks:
            all_issues.extend(result.issues)
            all_warnings.extend(result.warnings)
            all_recommendations.extend(result.recommendations)
        
        # Calculate overall compatibility and confidence
        overall_compatible = all(result.compatible for result in checks)
        overall_confidence = np.mean([result.confidence_score for result in checks])
        
        # Generate performance estimate
        performance_estimate = None
        if overall_compatible:
            performance_estimate = self.performance_estimator.estimate_performance(
                model_spec, env_spec
            )
        
        return CompatibilityResult(
            compatible=overall_compatible,
            confidence_score=overall_confidence,
            issues=all_issues,
            warnings=all_warnings,
            recommendations=all_recommendations,
            performance_estimate=performance_estimate
        )
    
    async def _run_framework_check(self, model_spec: ModelSpec,
                                 env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Run framework compatibility check"""
        return self.framework_checker.check_framework_compatibility(model_spec, env_spec)
    
    async def _run_hardware_check(self, model_spec: ModelSpec,
                                env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Run hardware compatibility check"""
        return self.hardware_checker.check_hardware_compatibility(model_spec, env_spec)
    
    async def _run_platform_check(self, model_spec: ModelSpec,
                                env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Run platform compatibility check"""
        return self.platform_checker.check_platform_compatibility(model_spec, env_spec)
    
    async def _run_dependency_check(self, model_spec: ModelSpec,
                                  env_spec: EnvironmentSpec) -> CompatibilityResult:
        """Run dependency compatibility check"""
        return self.dependency_checker.check_dependency_compatibility(model_spec, env_spec)
    
    async def batch_compatibility_check(self, model_spec: ModelSpec,
                                      environments: List[EnvironmentSpec]) -> Dict[str, CompatibilityResult]:
        """Check compatibility against multiple environments"""
        
        tasks = [
            self.check_compatibility(model_spec, env)
            for env in environments
        ]
        
        results = await asyncio.gather(*tasks)
        
        return {
            env.name: result
            for env, result in zip(environments, results)
        }
    
    def discover_current_environment(self) -> EnvironmentSpec:
        """Discover current environment specifications"""
        
        # Get system information
        system_info = {
            'platform': platform.system().lower(),
            'architecture': platform.machine(),
            'python_version': platform.python_version(),
            'cpu_cores': psutil.cpu_count(),
            'memory_gb': psutil.virtual_memory().total / (1024**3)
        }
        
        # Detect available frameworks
        frameworks = {}
        
        # Check PyTorch
        try:
            import torch
            frameworks['pytorch'] = torch.__version__
        except ImportError:
            pass
        
        # Check TensorFlow
        try:
            # Import TensorFlow via gestionnaire centralisé
try:
    from core.tensorflow_manager import get_tensorflow_manager
    tf_manager = get_tensorflow_manager()
    tf = tf_manager.tf
except ImportError:
    import tensorflow as tf
            frameworks['tensorflow'] = tf.__version__
        except ImportError:
            pass
        
        # Check ONNX
        try:
            import onnx
            frameworks['onnx'] = onnx.__version__
        except ImportError:
            pass
        
        # Check scikit-learn
        try:
            import sklearn
            frameworks['sklearn'] = sklearn.__version__
        except ImportError:
            pass
        
        # Check GPU support
        gpu_support = False
        gpu_memory = 0
        try:
            gpus = GPUtil.getGPUs()
            if gpus:
                gpu_support = True
                gpu_memory = max(gpu.memoryTotal for gpu in gpus) / 1024  # Convert to GB
        except Exception:
            pass
        
        # Check container runtime
        container_runtime = None
        try:
            docker_client = docker.from_env()
            container_runtime = 'docker'
        except Exception:
            pass
        
        return EnvironmentSpec(
            name='current',
            platform=system_info['platform'],
            architecture=system_info['architecture'],
            python_version=system_info['python_version'],
            frameworks=frameworks,
            hardware={
                'cpu_cores': system_info['cpu_cores'],
                'memory_gb': system_info['memory_gb'],
                'gpu_memory_gb': gpu_memory
            },
            container_runtime=container_runtime,
            gpu_support=gpu_support
        )
    
    def generate_compatibility_report(self, model_spec: ModelSpec,
                                    results: Dict[str, CompatibilityResult]) -> Dict[str, Any]:
        """Generate comprehensive compatibility report"""
        
        compatible_envs = [
            env_name for env_name, result in results.items()
            if result.compatible
        ]
        
        incompatible_envs = [
            env_name for env_name, result in results.items()
            if not result.compatible
        ]
        
        avg_confidence = np.mean([
            result.confidence_score for result in results.values()
        ])
        
        all_issues = []
        all_recommendations = []
        
        for env_name, result in results.items():
            for issue in result.issues:
                all_issues.append(f"{env_name}: {issue}")
            for rec in result.recommendations:
                all_recommendations.append(f"{env_name}: {rec}")
        
        return {
            'model_id': model_spec.model_id,
            'model_version': model_spec.model_version,
            'summary': {
                'total_environments': len(results),
                'compatible_environments': len(compatible_envs),
                'incompatible_environments': len(incompatible_envs),
                'average_confidence': avg_confidence
            },
            'compatible_environments': compatible_envs,
            'incompatible_environments': incompatible_envs,
            'issues': all_issues,
            'recommendations': all_recommendations,
            'detailed_results': {
                env_name: {
                    'compatible': result.compatible,
                    'confidence': result.confidence_score,
                    'performance_estimate': result.performance_estimate,
                    'issues': result.issues,
                    'warnings': result.warnings,
                    'recommendations': result.recommendations
                }
                for env_name, result in results.items()
            },
            'generated_at': datetime.utcnow().isoformat()
        }

# Example usage and configuration
async def main():
    """Example usage of compatibility checker"""
    
    # Define a model specification
    model_spec = ModelSpec(
        model_id='content_classifier',
        model_version='v1.2.0',
        framework='pytorch',
        framework_version='1.9.0',
        model_format='pth',
        input_shapes={'input': [1, 3, 224, 224]},
        output_shapes={'output': [1, 1000]},
        model_size_mb=25.5,
        memory_requirement_mb=512,
        compute_requirement_ops=2_000_000_000,
        dependencies=['torch>=1.9.0', 'torchvision>=0.10.0'],
        gpu_required=False,
        min_python_version='3.8'
    )
    
    # Define target environments
    production_env = EnvironmentSpec(
        name='production-server',
        platform='linux',
        architecture='x86_64',
        python_version='3.9.7',
        frameworks={
            'pytorch': '1.10.0',
            'tensorflow': '2.8.0',
            'onnx': '1.11.0'
        },
        hardware={
            'cpu_cores': 8,
            'memory_gb': 32,
            'gpu_memory_gb': 8
        },
        gpu_support=True
    )
    
    mobile_env = EnvironmentSpec(
        name='android-device',
        platform='android',
        architecture='arm64',
        python_version='3.8.0',
        frameworks={
            'tflite': '2.8.0'
        },
        hardware={
            'cpu_cores': 4,
            'memory_gb': 4
        },
        memory_limit_gb=1,
        gpu_support=False
    )
    
    # Initialize compatibility checker
    checker = ModelCompatibilityChecker()
    
    # Check compatibility with production environment
    result = await checker.check_compatibility(model_spec, production_env)
    print(f"✅ Production compatibility: {result.compatible} "
          f"(confidence: {result.confidence_score:.2f})")
    
    if result.issues:
        print(f"Issues: {result.issues}")
    if result.recommendations:
        print(f"Recommendations: {result.recommendations}")
    
    # Batch check against multiple environments
    environments = [production_env, mobile_env]
    batch_results = await checker.batch_compatibility_check(model_spec, environments)
    
    # Generate comprehensive report
    report = checker.generate_compatibility_report(model_spec, batch_results)
    print(f"✅ Compatibility report: {report['summary']}")
    
    # Discover current environment
    current_env = checker.discover_current_environment()
    print(f"✅ Current environment: {current_env.name} "
          f"({current_env.platform}/{current_env.architecture})")

if __name__ == "__main__":
    asyncio.run(main())