{
  "backend_url": "http://localhost:8000",
  "frontend_url": "http://localhost:3000",
  "check_interval": 30,
  "timeout": 10,
  "alert_threshold": 3,
  "retention_days": 30,
  "alerts": {
    "enabled": true,
    "webhooks": [],
    "email": {
      "enabled": false,
      "smtp_server": "",
      "smtp_port": 587,
      "username": "",
      "password": "",
      "recipients": []
    },
    "slack": {
      "enabled": false,
      "webhook_url": ""
    }
  },
  "monitoring_rules": {
    "response_time_threshold_ms": 5000,
    "uptime_threshold_percent": 95,
    "error_rate_threshold_percent": 5
  },
  "enterprise_modules": {
    "ai_services": {
      "priority": "critical",
      "expected_agents": 53,
      "max_response_time_ms": 3000
    },
    "analytics_services": {
      "priority": "critical", 
      "max_response_time_ms": 2000
    },
    "audio_processing": {
      "priority": "critical",
      "max_response_time_ms": 5000
    },
    "security_services": {
      "priority": "critical",
      "max_response_time_ms": 1000
    },
    "api_gateway": {
      "priority": "critical",
      "max_response_time_ms": 500
    }
  }
}