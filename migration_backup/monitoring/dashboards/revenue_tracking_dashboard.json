{
  "dashboard": {
    "id": null,
    "title": "Ainflue Revenue Tracking Dashboard",
    "tags": ["ainflue", "revenue", "monetization", "financial"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "hideControls": false,
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "1m",
    "schemaVersion": 39,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Total Revenue Today",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(revenue_total_cents[1d])) / 100",
            "interval": "",
            "legendFormat": "Today's Revenue",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5000
                },
                {
                  "color": "green",
                  "value": 20000
                }
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Revenue This Month",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(revenue_total_cents[30d])) / 100",
            "interval": "",
            "legendFormat": "Monthly Revenue",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 150000
                },
                {
                  "color": "green",
                  "value": 600000
                }
              ]
            },
            "unit": "currencyUSD",
            "decimals": 0
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 8,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Revenue Growth Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "((sum(increase(revenue_total_cents[7d])) / 100) - (sum(increase(revenue_total_cents[7d] offset 7d)) / 100)) / (sum(increase(revenue_total_cents[7d] offset 7d)) / 100) * 100",
            "interval": "",
            "legendFormat": "Week-over-Week Growth",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 10
                }
              ]
            },
            "unit": "percent",
            "decimals": 1
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 16,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Revenue by Platform (7 days)",
        "type": "barchart",
        "targets": [
          {
            "expr": "sum by (platform) (increase(revenue_total_cents{platform=~\"$platform\"}[7d])) / 100",
            "interval": "",
            "legendFormat": "{{ platform }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 80,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "currencyUSD"
          }
        },
        "options": {
          "orientation": "horizontal",
          "barWidth": 0.6,
          "groupWidth": 0.7,
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 10,
          "w": 12,
          "x": 0,
          "y": 9
        }
      },
      {
        "id": 5,
        "title": "Revenue by Creator (Top 10)",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum by (creator_id) (increase(revenue_total_cents[7d])) / 100)",
