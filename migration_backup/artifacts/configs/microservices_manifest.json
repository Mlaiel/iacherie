  "infrastructure_services": {
    "count": 18,
    "category": "Platform Infrastructure",
    "services": [
      {
        "name": "unified_monitoring_service",
        "port": 9090,
        "replicas": 3,
        "resources": {
          "cpu": "500m",
          "memory": "1Gi",
          "storage": "10Gi"
        },
        "health_check": "/health",
        "dependencies": ["prometheus", "grafana"],
        "sla": {
          "availability": "99.99%",
          "response_time": "<100ms"
        }
      },
      {
        "name": "unified_configuration_service",
        "port": 8500,
        "replicas": 3,
        "resources": {
          "cpu": "200m",
          "memory": "512Mi",
          "storage": "5Gi"
        },
        "health_check": "/health",
        "dependencies": ["vault", "consul"],
        "sla": {
          "availability": "99.99%",
          "response_time": "<50ms"
        }
      },
      {
        "name": "backup_recovery_service",
        "port": 8080,
        "replicas": 2,
        "resources": {
          "cpu": "1000m",
          "memory": "2Gi",
          "storage": "100Gi"
        },
        "schedule": "0 2 * * *",
        "retention": "90 days",
        "encryption": "AES-256-GCM"
      },
      {
        "name": "enterprise_orchestration_service",
        "port": 8000,
        "replicas": 5,
        "resources": {
          "cpu": "2000m",
          "memory": "4Gi",
          "storage": "20Gi"
        },
        "circuit_breaker": true,
        "rate_limiting": "1000/min",
        "timeout": "30s"
      },
      {
        "name": "security_vault_service",
        "port": 8200,
        "replicas": 3,
        "resources": {
          "cpu": "500m",
          "memory": "1Gi",
          "storage": "50Gi"
        },
        "encryption": "AES-256-GCM",
        "key_rotation": "90 days",
        "audit_logging": true
      }
    ]
  },
