  "platform_services": {
    "count": 65,
    "category": "Platform Integration",
    "subcategories": {
      "social_media": {
        "count": 29,
        "services": [
          {
            "name": "instagram_connector",
            "api_version": "v18.0",
            "port": 8100,
            "replicas": 5,
            "rate_limits": {
              "requests_per_hour": 200,
              "uploads_per_day": 25
            },
            "supported_content": ["photo", "video", "story", "reel"],
            "webhook_support": true
          },
          {
            "name": "youtube_connector",
            "api_version": "v3",
            "port": 8101,
            "replicas": 3,
            "rate_limits": {
              "quota_units_per_day": 10000
            },
            "supported_content": ["video", "shorts", "live_stream"],
            "max_file_size": "256GB"
          },
          {
            "name": "tiktok_connector",
            "api_version": "v1.3",
            "port": 8102,
            "replicas": 4,
            "rate_limits": {
              "requests_per_day": 1000
            },
            "supported_content": ["video", "live_stream"],
            "max_duration": "60s"
          }
        ]
      },
