# MySQL Configuration Template for Ainflue Platform
# Relational database configuration for transactional data and financial records

[client]
# Default connection settings
port                           = 3306
socket                         = /var/run/mysqld/mysqld.sock
default-character-set          = utf8mb4

[mysql]
# MySQL client settings
default-character-set          = utf8mb4
auto-rehash                    = FALSE

[mysqld_safe]
# Safe startup settings
socket                         = /var/run/mysqld/mysqld.sock
nice                          = 0
log-error                     = /var/log/mysql/error.log

[mysqld]
# Basic Settings
user                          = mysql
pid-file                      = /var/run/mysqld/mysqld.pid
socket                        = /var/run/mysqld/mysqld.sock
port                          = 3306
basedir                       = /usr
datadir                       = /var/lib/mysql
tmpdir                        = /tmp
lc-messages-dir               = /usr/share/mysql
skip-external-locking

# Character Set and Collation
character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_ci
init-connect                  = 'SET NAMES utf8mb4'

# Network Settings
bind-address                  = 0.0.0.0
max_connections               = 500
max_user_connections          = 450
max_connect_errors            = 100000
back_log                      = 512
thread_cache_size             = 50
thread_stack                  = 256K
interactive_timeout           = 28800
wait_timeout                  = 28800
connect_timeout               = 10

# Memory Settings
# Adjust based on available RAM (recommended: 70-80% of available RAM)
innodb_buffer_pool_size       = ${MYSQL_INNODB_BUFFER_POOL_SIZE:4G}
innodb_buffer_pool_instances  = 4
innodb_log_buffer_size        = 64M
key_buffer_size               = 128M
query_cache_size              = 0
query_cache_type              = 0
sort_buffer_size              = 2M
read_buffer_size              = 1M
read_rnd_buffer_size          = 4M
join_buffer_size              = 2M
bulk_insert_buffer_size       = 16M

# MyISAM Settings
myisam_sort_buffer_size       = 64M
myisam_max_sort_file_size     = 10G
myisam_repair_threads         = 1

# InnoDB Settings
innodb_file_per_table         = 1
innodb_flush_log_at_trx_commit = 2
innodb_log_file_size          = 1G
innodb_log_files_in_group     = 2
innodb_flush_method           = O_DIRECT
innodb_lock_wait_timeout      = 50
innodb_rollback_on_timeout    = ON
innodb_print_all_deadlocks    = ON
innodb_adaptive_hash_index    = ON
innodb_read_io_threads        = 8
innodb_write_io_threads       = 8
innodb_io_capacity            = 1000
innodb_io_capacity_max        = 2000
innodb_purge_threads          = 4
innodb_adaptive_flushing      = ON
innodb_change_buffering       = all
innodb_old_blocks_time        = 1000
innodb_stats_on_metadata      = OFF
innodb_stats_persistent       = ON
innodb_stats_auto_recalc      = ON
innodb_checksum_algorithm     = crc32
innodb_file_format            = Barracuda
innodb_large_prefix           = ON
innodb_thread_concurrency     = 0
innodb_commit_concurrency     = 0
innodb_read_only              = OFF
innodb_deadlock_detect        = ON

# Logging
general_log                   = OFF
general_log_file              = /var/log/mysql/general.log
slow_query_log                = ON
slow_query_log_file           = /var/log/mysql/slow.log
long_query_time               = 2
log_queries_not_using_indexes = ON
log_slow_admin_statements     = ON
log_slow_slave_statements     = ON
log_throttle_queries_not_using_indexes = 10
min_examined_row_limit        = 100

# Binary Logging (for replication and backups)
server-id                     = ${MYSQL_SERVER_ID:1}
log-bin                       = /var/log/mysql/mysql-bin
binlog_format                 = ROW
binlog_cache_size             = 1M
max_binlog_cache_size         = 2G
max_binlog_size               = 1G
expire_logs_days              = 7
binlog_row_image              = FULL
binlog_rows_query_log_events  = ON
log_slave_updates             = ON
relay_log                     = /var/log/mysql/relay-bin
relay_log_recovery            = ON

# GTID (Global Transaction Identifier)
gtid_mode                     = ON
enforce_gtid_consistency      = ON

# Replication Settings
skip_slave_start              = OFF
slave_skip_errors             = OFF
slave_net_timeout             = 60
slave_parallel_workers        = 4
slave_parallel_type           = LOGICAL_CLOCK
slave_preserve_commit_order   = ON
slave_transaction_retries     = 10

# Security Settings
ssl                           = ON
ssl_cert                      = /etc/mysql/ssl/server-cert.pem
ssl_key                       = /etc/mysql/ssl/server-key.pem
ssl_ca                        = /etc/mysql/ssl/ca-cert.pem
require_secure_transport      = ON

# Performance Schema
performance_schema            = ON
performance_schema_consumer_events_statements_current = ON
performance_schema_consumer_events_statements_history = ON
performance_schema_consumer_events_statements_history_long = OFF
performance_schema_consumer_events_waits_current = ON
performance_schema_consumer_events_waits_history = ON
performance_schema_consumer_events_waits_history_long = OFF

# Other Settings
max_allowed_packet            = 256M
max_heap_table_size           = 256M
tmp_table_size                = 256M
table_open_cache              = 4000
table_definition_cache        = 2000
open_files_limit              = 65535
max_prepared_stmt_count       = 16382

# SQL Mode
sql_mode                      = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# Time Zone
default_time_zone             = '+00:00'

# Session Settings
session_track_schema          = ON
session_track_state_change    = ON
session_track_system_variables = 'autocommit,character_set_client,character_set_connection,character_set_results,time_zone'

[mysqldump]
# Dump settings
quick
quote-names
max_allowed_packet            = 256M
default-character-set         = utf8mb4

[mysql]
default-character-set         = utf8mb4

[isamchk]
key_buffer_size               = 256M
sort_buffer_size              = 256M
read_buffer                   = 2M
write_buffer                  = 2M

[myisamchk]
key_buffer_size               = 256M
sort_buffer_size              = 256M
read_buffer                   = 2M
write_buffer                  = 2M

[mysqlhotcopy]
interactive-timeout

---
# MySQL User Management for Ainflue Platform

-- Admin user
CREATE USER 'ainflue_admin'@'%' IDENTIFIED BY '${MYSQL_ADMIN_PASSWORD}';
GRANT ALL PRIVILEGES ON *.* TO 'ainflue_admin'@'%' WITH GRANT OPTION;

-- Application user
CREATE USER 'ainflue_app'@'%' IDENTIFIED BY '${MYSQL_APP_PASSWORD}';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES, TRIGGER 
ON ainflue.* TO 'ainflue_app'@'%';

-- Read-only user for analytics
CREATE USER 'ainflue_readonly'@'%' IDENTIFIED BY '${MYSQL_READONLY_PASSWORD}';
GRANT SELECT ON ainflue.* TO 'ainflue_readonly'@'%';

-- Backup user
CREATE USER 'ainflue_backup'@'localhost' IDENTIFIED BY '${MYSQL_BACKUP_PASSWORD}';
GRANT SELECT, SHOW DATABASES, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER, RELOAD, PROCESS
ON *.* TO 'ainflue_backup'@'localhost';

-- Replication user
CREATE USER 'replication'@'%' IDENTIFIED BY '${MYSQL_REPLICATION_PASSWORD}';
GRANT REPLICATION SLAVE, REPLICATION CLIENT ON *.* TO 'replication'@'%';

-- Monitoring user
CREATE USER 'ainflue_monitor'@'%' IDENTIFIED BY '${MYSQL_MONITOR_PASSWORD}';
GRANT SELECT, PROCESS, REPLICATION CLIENT ON *.* TO 'ainflue_monitor'@'%';

FLUSH PRIVILEGES;

---
# Database Schema for Ainflue Platform

-- Create database
CREATE DATABASE IF NOT EXISTS ainflue 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

USE ainflue;

-- Users table
CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    uuid CHAR(36) UNIQUE NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    phone VARCHAR(20),
    date_of_birth DATE,
    gender ENUM('male', 'female', 'other', 'prefer_not_to_say'),
    timezone VARCHAR(50) DEFAULT 'UTC',
    language VARCHAR(10) DEFAULT 'en',
    is_verified BOOLEAN DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    last_login_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    INDEX idx_email (email),
    INDEX idx_uuid (uuid),
    INDEX idx_created_at (created_at),
    INDEX idx_is_active (is_active)
) ENGINE=InnoDB;

-- Brands table
CREATE TABLE brands (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    company_name VARCHAR(255) NOT NULL,
    industry VARCHAR(100),
    website VARCHAR(255),
    description TEXT,
    logo_url VARCHAR(500),
    company_size ENUM('startup', 'small', 'medium', 'large', 'enterprise'),
    annual_revenue DECIMAL(15,2),
    headquarters_country VARCHAR(2),
    headquarters_city VARCHAR(100),
    tax_id VARCHAR(50),
    is_verified BOOLEAN DEFAULT FALSE,
    verification_status ENUM('pending', 'approved', 'rejected') DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_user_id (user_id),
    INDEX idx_industry (industry),
    INDEX idx_verification_status (verification_status),
    INDEX idx_company_size (company_size)
) ENGINE=InnoDB;

-- Creators table
CREATE TABLE creators (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    username VARCHAR(100) UNIQUE NOT NULL,
    bio TEXT,
    profile_image_url VARCHAR(500),
    cover_image_url VARCHAR(500),
    categories JSON,
    follower_count BIGINT DEFAULT 0,
    following_count BIGINT DEFAULT 0,
    engagement_rate DECIMAL(5,4) DEFAULT 0.0000,
    average_views BIGINT DEFAULT 0,
    content_count BIGINT DEFAULT 0,
    rating DECIMAL(3,2) DEFAULT 0.00,
    is_verified BOOLEAN DEFAULT FALSE,
    is_available BOOLEAN DEFAULT TRUE,
    hourly_rate DECIMAL(10,2),
    country VARCHAR(2),
    city VARCHAR(100),
    languages JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_user_id (user_id),
    INDEX idx_username (username),
    INDEX idx_follower_count (follower_count),
    INDEX idx_engagement_rate (engagement_rate),
    INDEX idx_is_verified (is_verified),
    INDEX idx_is_available (is_available),
    INDEX idx_country_city (country, city),
    FULLTEXT idx_bio_search (username, bio)
) ENGINE=InnoDB;

-- Campaigns table
CREATE TABLE campaigns (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    brand_id BIGINT NOT NULL,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    objectives JSON,
    budget_min DECIMAL(10,2),
    budget_max DECIMAL(10,2),
    budget_currency VARCHAR(3) DEFAULT 'USD',
    start_date DATE,
    end_date DATE,
    application_deadline DATE,
    status ENUM('draft', 'active', 'paused', 'completed', 'cancelled') DEFAULT 'draft',
    requirements JSON,
    deliverables JSON,
    target_audience JSON,
    categories JSON,
    platforms JSON,
    compensation_type ENUM('fixed', 'performance', 'hybrid'),
    payment_terms VARCHAR(100),
    content_guidelines TEXT,
    hashtags JSON,
    approval_required BOOLEAN DEFAULT TRUE,
    max_creators INT DEFAULT NULL,
    application_count INT DEFAULT 0,
    selected_count INT DEFAULT 0,
    views_count BIGINT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (brand_id) REFERENCES brands(id) ON DELETE CASCADE,
    INDEX idx_brand_id (brand_id),
    INDEX idx_status (status),
    INDEX idx_start_end_date (start_date, end_date),
    INDEX idx_application_deadline (application_deadline),
    INDEX idx_budget_range (budget_min, budget_max),
    INDEX idx_created_at (created_at),
    FULLTEXT idx_title_description (title, description)
) ENGINE=InnoDB;

-- Campaign applications table
CREATE TABLE campaign_applications (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    campaign_id BIGINT NOT NULL,
    creator_id BIGINT NOT NULL,
    status ENUM('pending', 'approved', 'rejected', 'withdrawn') DEFAULT 'pending',
    proposal TEXT,
    proposed_rate DECIMAL(10,2),
    estimated_reach BIGINT,
    estimated_engagement BIGINT,
    portfolio_urls JSON,
    application_message TEXT,
    brand_response TEXT,
    applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    reviewed_at TIMESTAMP NULL,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (campaign_id) REFERENCES campaigns(id) ON DELETE CASCADE,
    FOREIGN KEY (creator_id) REFERENCES creators(id) ON DELETE CASCADE,
    UNIQUE KEY unique_application (campaign_id, creator_id),
    INDEX idx_campaign_id (campaign_id),
    INDEX idx_creator_id (creator_id),
    INDEX idx_status (status),
    INDEX idx_applied_at (applied_at)
) ENGINE=InnoDB;

-- Collaborations table
CREATE TABLE collaborations (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    campaign_id BIGINT NOT NULL,
    creator_id BIGINT NOT NULL,
    brand_id BIGINT NOT NULL,
    status ENUM('active', 'completed', 'cancelled', 'disputed') DEFAULT 'active',
    contract_terms JSON,
    agreed_rate DECIMAL(10,2),
    currency VARCHAR(3) DEFAULT 'USD',
    deliverables JSON,
    milestones JSON,
    start_date DATE,
    end_date DATE,
    completion_percentage DECIMAL(5,2) DEFAULT 0.00,
    brand_rating TINYINT,
    creator_rating TINYINT,
    brand_feedback TEXT,
    creator_feedback TEXT,
    total_earnings DECIMAL(10,2) DEFAULT 0.00,
    commission_rate DECIMAL(5,4) DEFAULT 0.1000,
    commission_amount DECIMAL(10,2) DEFAULT 0.00,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (campaign_id) REFERENCES campaigns(id) ON DELETE CASCADE,
    FOREIGN KEY (creator_id) REFERENCES creators(id) ON DELETE CASCADE,
    FOREIGN KEY (brand_id) REFERENCES brands(id) ON DELETE CASCADE,
    INDEX idx_campaign_id (campaign_id),
    INDEX idx_creator_id (creator_id),
    INDEX idx_brand_id (brand_id),
    INDEX idx_status (status),
    INDEX idx_start_end_date (start_date, end_date)
) ENGINE=InnoDB;

-- Payments table
CREATE TABLE payments (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    collaboration_id BIGINT NOT NULL,
    payer_type ENUM('brand', 'platform') NOT NULL,
    payee_type ENUM('creator', 'platform') NOT NULL,
    amount DECIMAL(10,2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'USD',
    payment_type ENUM('milestone', 'commission', 'bonus', 'refund'),
    status ENUM('pending', 'processing', 'completed', 'failed', 'cancelled') DEFAULT 'pending',
    payment_method VARCHAR(50),
    transaction_id VARCHAR(100),
    payment_provider VARCHAR(50),
    processing_fee DECIMAL(10,2) DEFAULT 0.00,
    net_amount DECIMAL(10,2),
    description TEXT,
    metadata JSON,
    scheduled_at TIMESTAMP NULL,
    processed_at TIMESTAMP NULL,
    failed_reason TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (collaboration_id) REFERENCES collaborations(id) ON DELETE CASCADE,
    INDEX idx_collaboration_id (collaboration_id),
    INDEX idx_status (status),
    INDEX idx_payment_type (payment_type),
    INDEX idx_scheduled_at (scheduled_at),
    INDEX idx_created_at (created_at),
    INDEX idx_transaction_id (transaction_id)
) ENGINE=InnoDB;

-- Content table
CREATE TABLE content (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    collaboration_id BIGINT NOT NULL,
    platform VARCHAR(50) NOT NULL,
    content_type ENUM('post', 'story', 'video', 'reel', 'tiktok', 'youtube_video', 'blog_post'),
    title VARCHAR(255),
    description TEXT,
    content_url VARCHAR(500),
    thumbnail_url VARCHAR(500),
    hashtags JSON,
    mentions JSON,
    scheduled_at TIMESTAMP NULL,
    published_at TIMESTAMP NULL,
    status ENUM('draft', 'pending_approval', 'approved', 'published', 'rejected') DEFAULT 'draft',
    approval_notes TEXT,
    metrics JSON,
    views_count BIGINT DEFAULT 0,
    likes_count BIGINT DEFAULT 0,
    comments_count BIGINT DEFAULT 0,
    shares_count BIGINT DEFAULT 0,
    engagement_rate DECIMAL(5,4) DEFAULT 0.0000,
    reach BIGINT DEFAULT 0,
    impressions BIGINT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (collaboration_id) REFERENCES collaborations(id) ON DELETE CASCADE,
    INDEX idx_collaboration_id (collaboration_id),
    INDEX idx_platform (platform),
    INDEX idx_content_type (content_type),
    INDEX idx_status (status),
    INDEX idx_published_at (published_at),
    INDEX idx_engagement_rate (engagement_rate)
) ENGINE=InnoDB;

-- Financial transactions table
CREATE TABLE financial_transactions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    user_type ENUM('creator', 'brand') NOT NULL,
    transaction_type ENUM('deposit', 'withdrawal', 'earning', 'payment', 'commission', 'refund', 'fee'),
    amount DECIMAL(15,2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'USD',
    description TEXT,
    reference_type ENUM('payment', 'collaboration', 'campaign', 'refund', 'commission') NULL,
    reference_id BIGINT NULL,
    status ENUM('pending', 'completed', 'failed', 'cancelled') DEFAULT 'pending',
    external_transaction_id VARCHAR(100),
    payment_provider VARCHAR(50),
    payment_method VARCHAR(50),
    processing_fee DECIMAL(10,2) DEFAULT 0.00,
    net_amount DECIMAL(15,2),
    balance_before DECIMAL(15,2),
    balance_after DECIMAL(15,2),
    metadata JSON,
    processed_at TIMESTAMP NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_user_id (user_id),
    INDEX idx_user_type (user_type),
    INDEX idx_transaction_type (transaction_type),
    INDEX idx_status (status),
    INDEX idx_reference (reference_type, reference_id),
    INDEX idx_created_at (created_at),
    INDEX idx_external_transaction_id (external_transaction_id)
) ENGINE=InnoDB;

---
# MySQL Performance Optimization

-- Performance monitoring queries
SELECT * FROM INFORMATION_SCHEMA.PROCESSLIST WHERE COMMAND != 'Sleep';

SELECT 
    SCHEMA_NAME,
    ROUND(SUM(DATA_LENGTH + INDEX_LENGTH) / 1024 / 1024, 2) AS 'DB Size (MB)'
FROM INFORMATION_SCHEMA.SCHEMATA S
LEFT JOIN INFORMATION_SCHEMA.TABLES T ON S.SCHEMA_NAME = T.TABLE_SCHEMA
GROUP BY SCHEMA_NAME;

-- Slow query analysis
SELECT 
    query_time,
    lock_time,
    rows_sent,
    rows_examined,
    sql_text
FROM mysql.slow_log
ORDER BY query_time DESC
LIMIT 10;

-- Index usage analysis
SELECT 
    TABLE_SCHEMA,
    TABLE_NAME,
    INDEX_NAME,
    SEQ_IN_INDEX,
    COLUMN_NAME,
    CARDINALITY
FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_SCHEMA = 'ainflue'
ORDER BY TABLE_NAME, INDEX_NAME, SEQ_IN_INDEX;

---
# MySQL Backup and Restore Scripts

#!/bin/bash
# Backup script
BACKUP_DIR="/backups/mysql/$(date +%Y%m%d_%H%M%S)"
mkdir -p $BACKUP_DIR

mysqldump \
  --user=$MYSQL_BACKUP_USER \
  --password=$MYSQL_BACKUP_PASSWORD \
  --single-transaction \
  --routines \
  --triggers \
  --events \
  --add-drop-database \
  --databases ainflue \
  > $BACKUP_DIR/ainflue_backup.sql

# Compress backup
gzip $BACKUP_DIR/ainflue_backup.sql

# Upload to S3
aws s3 cp $BACKUP_DIR s3://ainflue-db-backups/mysql/ --recursive

echo "Backup completed: $BACKUP_DIR"

#!/bin/bash
# Restore script
BACKUP_FILE=$1
if [ -z "$BACKUP_FILE" ]; then
  echo "Usage: $0 <backup_file>"
  exit 1
fi

mysql \
  --user=$MYSQL_ADMIN_USER \
  --password=$MYSQL_ADMIN_PASSWORD \
  < $BACKUP_FILE

echo "Restore completed from: $BACKUP_FILE"