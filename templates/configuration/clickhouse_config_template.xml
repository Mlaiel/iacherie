# ClickHouse Database Schema for Ainflue

-- Create database
CREATE DATABASE IF NOT EXISTS ainflue;
USE ainflue;

-- User activity events table
CREATE TABLE user_activities
(
    event_time DateTime,
    user_id String,
    session_id String,
    activity_type String,
    page_url String,
    referrer String,
    user_agent String,
    ip_address IPv4,
    country String,
    city String,
    device_type String,
    platform String,
    campaign_id String,
    content_id String,
    duration UInt32,
    metadata String
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(event_time)
ORDER BY (user_id, event_time)
TTL event_time + INTERVAL 90 DAY;

-- Content performance metrics table
CREATE TABLE content_metrics
(
    metric_time DateTime,
    content_id String,
    creator_id String,
    platform String,
    content_type String,
    campaign_id String,
    views UInt64,
    likes UInt64,
    comments UInt64,
    shares UInt64,
    saves UInt64,
    reach UInt64,
    impressions UInt64,
    engagement_rate Float32,
    click_through_rate Float32,
    conversion_rate Float32,
    revenue Decimal(10,2),
    cost Decimal(10,2)
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(metric_time)
ORDER BY (content_id, metric_time)
TTL metric_time + INTERVAL 365 DAY;

-- Creator performance analytics
CREATE TABLE creator_performance
(
    analysis_date Date,
    creator_id String,
    platform String,
    category String,
    follower_count UInt64,
    following_count UInt64,
    post_count UInt32,
    avg_engagement_rate Float32,
    total_reach UInt64,
    total_impressions UInt64,
    total_revenue Decimal(12,2),
    campaign_count UInt32,
    brand_rating_avg Float32,
    content_count UInt32,
    top_content_ids Array(String),
    demographics_age Array(String),
    demographics_gender Array(String),
    demographics_location Array(String)
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(analysis_date)
ORDER BY (creator_id, analysis_date);

-- Campaign analytics table
CREATE TABLE campaign_analytics
(
    metric_time DateTime,
    campaign_id String,
    brand_id String,
    campaign_status String,
    total_spend Decimal(12,2),
    total_revenue Decimal(12,2),
    total_reach UInt64,
    total_impressions UInt64,
    total_engagement UInt64,
    participating_creators UInt32,
    content_pieces UInt32,
    avg_engagement_rate Float32,
    cost_per_engagement Decimal(8,4),
    cost_per_view Decimal(8,4),
    roi Float32,
    conversion_rate Float32,
    target_demographics Array(String),
    platforms Array(String),
    categories Array(String)
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(metric_time)
ORDER BY (campaign_id, metric_time);

-- Revenue tracking table
CREATE TABLE revenue_tracking
(
    transaction_time DateTime,
    transaction_id String,
    user_id String,
    user_type Enum('creator', 'brand'),
    transaction_type Enum('earning', 'payment', 'commission', 'fee', 'refund'),
    amount Decimal(12,2),
    currency String,
    payment_method String,
    campaign_id String,
    collaboration_id String,
    status Enum('pending', 'completed', 'failed', 'cancelled'),
    processing_fee Decimal(10,2),
    net_amount Decimal(12,2),
    metadata String
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(transaction_time)
ORDER BY (user_id, transaction_time);

-- Audience demographics aggregated table
CREATE TABLE audience_demographics
(
    analysis_date Date,
    creator_id String,
    platform String,
    age_group String,
    gender String,
    country String,
    city String,
    audience_count UInt64,
    percentage Float32,
    engagement_rate Float32,
    growth_rate Float32
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(analysis_date)
ORDER BY (creator_id, platform, analysis_date);

-- Real-time engagement events
CREATE TABLE engagement_events
(
    event_time DateTime,
    content_id String,
    user_id String,
    event_type Enum('view', 'like', 'comment', 'share', 'save', 'click'),
    platform String,
    device_type String,
    location String,
    session_id String
)
ENGINE = MergeTree()
PARTITION BY toYYYYMMDD(event_time)
ORDER BY (content_id, event_time)
TTL event_time + INTERVAL 30 DAY;

-- API performance metrics
CREATE TABLE api_metrics
(
    request_time DateTime,
    endpoint String,
    method String,
    status_code UInt16,
    response_time UInt32,
    request_size UInt32,
    response_size UInt32,
    user_id String,
    user_agent String,
    ip_address IPv4,
    error_message String
)
ENGINE = MergeTree()
PARTITION BY toYYYYMMDD(request_time)
ORDER BY (endpoint, request_time)
TTL request_time + INTERVAL 30 DAY;

