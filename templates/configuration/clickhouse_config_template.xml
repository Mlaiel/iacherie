# ClickHouse Backup and Restore

#!/bin/bash
# ClickHouse backup script
BACKUP_DIR="/backups/clickhouse/$(date +%Y%m%d_%H%M%S)"
mkdir -p $BACKUP_DIR

# Create backup using clickhouse-backup tool
clickhouse-backup create ainflue_backup_$(date +%Y%m%d_%H%M%S)

# Upload to S3
clickhouse-backup upload ainflue_backup_$(date +%Y%m%d_%H%M%S)

echo "ClickHouse backup completed"

# Performance monitoring queries
SELECT 
    query,
    user,
    query_duration_ms,
    read_rows,
    read_bytes,
    memory_usage
FROM system.query_log
WHERE type = 'QueryFinish'
  AND event_time >= now() - INTERVAL 1 HOUR
ORDER BY query_duration_ms DESC
LIMIT 10;