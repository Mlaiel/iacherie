# ClickHouse Materialized Views for Real-time Analytics

-- Daily creator performance summary
CREATE MATERIALIZED VIEW creator_daily_summary
ENGINE = SummingMergeTree()
PARTITION BY toYYYYMM(metric_date)
ORDER BY (creator_id, platform, metric_date)
AS SELECT
    toDate(metric_time) as metric_date,
    creator_id,
    platform,
    sum(views) as daily_views,
    sum(likes) as daily_likes,
    sum(comments) as daily_comments,
    sum(shares) as daily_shares,
    avg(engagement_rate) as avg_engagement_rate,
    sum(revenue) as daily_revenue,
    count() as content_count
FROM content_metrics
GROUP BY metric_date, creator_id, platform;

-- Hourly campaign performance
CREATE MATERIALIZED VIEW campaign_hourly_metrics
ENGINE = SummingMergeTree()
PARTITION BY toYYYYMM(metric_hour)
ORDER BY (campaign_id, metric_hour)
AS SELECT
    toStartOfHour(metric_time) as metric_hour,
    campaign_id,
    brand_id,
    sum(total_reach) as hourly_reach,
    sum(total_impressions) as hourly_impressions,
    sum(total_engagement) as hourly_engagement,
    sum(total_spend) as hourly_spend,
    avg(cost_per_engagement) as avg_cpe,
    count() as data_points
FROM campaign_analytics
GROUP BY metric_hour, campaign_id, brand_id;

-- Real-time engagement aggregation
CREATE MATERIALIZED VIEW engagement_realtime
ENGINE = SummingMergeTree()
PARTITION BY toYYYYMMDD(event_time)
ORDER BY (content_id, toStartOfMinute(event_time))
AS SELECT
    content_id,
    toStartOfMinute(event_time) as minute_bucket,
    event_type,
    platform,
    count() as event_count,
    uniq(user_id) as unique_users
FROM engagement_events
GROUP BY content_id, minute_bucket, event_type, platform;

