# Configuration complète pour test enterprise
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Security
SECRET_KEY=ainflue_enterprise_secret_key_for_testing_2025
JWT_SECRET=jwt_secret_enterprise_testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Database URLs (simulation for testing)
DATABASE_URL=sqlite:///./test_ainflue.db
REDIS_URL=redis://localhost:6379/0

# AI/ML Configuration
OPENAI_API_KEY=sk-test-key-for-demo
MODEL_CACHE_DIR=./models
MAX_TOKENS=2048

# Enterprise Features
ENTERPRISE_MODE=true
MONITORING_ENABLED=true
ANALYTICS_ENABLED=true
SECURITY_LEVEL=medium

# Test Configuration
TESTING=false
MOCK_EXTERNAL_SERVICES=true
