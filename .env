# Development Environment Configuration
# Copy from config/environments/.env.development.example
# 
# Ainflue Platform - Development Environment
# Author: Fahed Mlaiel (mlaiel@live.de)

# Application Settings
APP_NAME=Ainflue-Dev
APP_VERSION=1.0.0-dev
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# API Configuration
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Configuration (permissive for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Database Configuration (Local Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ainflue_dev
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=ainflue_development

# Redis Cache Database
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Configuration (Development only - NOT secure)
JWT_SECRET_KEY=dev_jwt_secret_key_not_for_production_use_only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=7200
ENCRYPTION_KEY=dev_encryption_key_not_for_production_use_only

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Performance Configuration
CACHE_TTL=60
DB_POOL_SIZE=5
REQUEST_TIMEOUT=60

# Feature Flags (All enabled for development)
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
AUTO_RELOAD=true
MOCK_EXTERNAL_CALLS=false