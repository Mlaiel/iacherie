# 🔐 CRITICAL SECURITY KEYS (MUST BE CHANGED IN PRODUCTION)
JWT_SECRET_KEY=enterprise_jwt_secret_key_2025_ainflue_ml_secure_production_change_me
DATABASE_PASSWORD=enterprise_db_secure_password_2025_ainflue_production_change_me
REDIS_PASSWORD=enterprise_redis_secure_password_2025_ainflue_production_change_me
API_ENCRYPTION_KEY=enterprise_api_encryption_key_2025_ainflue_ml_secure_change_me

# 🗄️ Database Configuration (DBA Expert)
DATABASE_URL=postgresql://ainflue_user:${DATABASE_PASSWORD}@localhost:5432/ainflue_production
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# 📊 Redis Configuration (Backend Senior)
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

# 🚀 ML Model Configuration (ML Engineer)
MODEL_CACHE_SIZE=1000
MODEL_INFERENCE_TIMEOUT=100
MODEL_BATCH_SIZE=32
MODEL_MAX_CONCURRENT_REQUESTS=100
MODEL_WARM_UP_ENABLED=true

# 📈 Performance Configuration (Backend Senior)
MAX_WORKERS=8
WORKER_TIMEOUT=120
KEEP_ALIVE=2
PRELOAD_APP=true
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50

# 🔍 Monitoring Configuration (DevOps)
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
LOGGING_LEVEL=INFO
PROMETHEUS_METRICS_PORT=9090
HEALTH_CHECK_PORT=8080

# 🌐 Microservices Configuration (Microservices Expert)
SERVICE_MESH_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
LOAD_BALANCER_ENABLED=true
SERVICE_DISCOVERY_ENABLED=true

# 🎵 Creator-Specific Configuration (Audio Engineer)
AUDIO_PROCESSING_ENABLED=true
AUDIO_SAMPLE_RATE=44100
AUDIO_BUFFER_SIZE=1024
AUDIO_MAX_DURATION=300

# 🤖 AI Configuration (IA Prompt Engineer)
AI_MODEL_OPTIMIZATION=true
AI_PROMPT_TEMPLATES_ENABLED=true
AI_QUALITY_ASSESSMENT=true
AI_BATCH_PROCESSING=true

# 🔒 Security Configuration (Sécurité Expert)
SECURITY_ENCRYPTION_ENABLED=true
SECURITY_AUDIT_ENABLED=true
SECURITY_COMPLIANCE_CHECKS=true
SECURITY_VULNERABILITY_SCANNING=true

# 🌍 Environment Configuration
ENVIRONMENT=production
DEBUG=false
TESTING=false
LOG_LEVEL=INFO

# 📡 API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30
API_MAX_REQUEST_SIZE=10485760

# 🔄 Background Tasks
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']
CELERY_TIMEZONE=UTC

# 📊 Feature Store Configuration
FEATURE_STORE_ENABLED=true
FEATURE_CACHE_TTL=3600
FEATURE_BATCH_SIZE=1000
FEATURE_VALIDATION_ENABLED=true

# 🚀 Model Registry Configuration
MODEL_REGISTRY_ENABLED=true
MODEL_VERSIONING_ENABLED=true
MODEL_ENCRYPTION_ENABLED=true
MODEL_COMPRESSION_ENABLED=true