# Ainflue Infrastructure Environment Variables
# Author: Fahed Mlaiel (mlaiel@live.de)
# Copyright: (c) 2025 Fahed Mlaiel. All rights reserved.
#
# Environment configuration for Docker Compose infrastructure services
# Copy this file to .env and configure the values for your environment

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET_KEY=your_jwt_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ==============================================================================
# DATABASE PASSWORDS
# ==============================================================================
FINGERPRINTS_DB_PASSWORD=ainflue_fp_2025_secure
MONETIZATION_DB_PASSWORD=ainflue_monetization_2025_secure
ANALYTICS_DB_PASSWORD=ainflue_analytics_2025_secure
INFLUXDB_PASSWORD=ainflue_influx_2025_secure

# ==============================================================================
# AUDIO PROCESSING
# ==============================================================================
AUDIO_S3_BUCKET=ainflue-audio-storage
AWS_REGION=us-east-1

# ==============================================================================
# BLOCKCHAIN & WEB3
# ==============================================================================
SMART_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your_project_id
IPFS_GATEWAY_URL=https://ipfs.infura.io:5001

# ==============================================================================
# EXTERNAL INTEGRATIONS
# ==============================================================================
# Payment Processing (Stripe, PayPal, etc.)
# These should be set as Docker secrets in production
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id

# ==============================================================================
# PERFORMANCE & SCALING
# ==============================================================================
# Redis Cache Settings
REDIS_MAX_MEMORY=1GB
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# Database Connection Pools
DB_MAX_CONNECTIONS=200
DB_POOL_SIZE=20

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
LOG_LEVEL=INFO
MONITORING_ENABLED=true
METRICS_RETENTION_DAYS=30

# ==============================================================================
# DEVELOPMENT/STAGING OVERRIDES
# ==============================================================================
# These can be overridden in .env.development, .env.staging files
DEBUG=false
DEVELOPMENT_MODE=false
TESTING_MODE=false

# ==============================================================================
# SERVICE ENDPOINTS (for inter-service communication)
# ==============================================================================
AUDIO_SERVICE_URL=http://ainflue-audio-coordinator:8080
PROTECTION_SERVICE_URL=http://ainflue-rights-api:8080
MONETIZATION_SERVICE_URL=http://ainflue-monetization-api:8080
ANALYTICS_SERVICE_URL=http://ainflue-analytics-api:8080