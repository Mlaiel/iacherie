# Testing Environment Variables for Ainflue Docker Infrastructure
# Author: Fahed Mlaiel (mlaiel@live.de)

# Database Configuration
TEST_DB_PASSWORD=test_password_123
TEST_DB_USER=ainflue_test
TEST_DB_NAME=ainflue_test_db
TEST_DB_HOST=test-postgres
TEST_DB_PORT=5432

# RabbitMQ Configuration  
TEST_RABBITMQ_PASSWORD=test_rabbit_123
TEST_RABBITMQ_USER=ainflue_test
TEST_RABBITMQ_HOST=test-rabbitmq
TEST_RABBITMQ_PORT=5672

# Application Configuration
TEST_APP_SECRET_KEY=test_secret_key_not_for_production
TEST_JWT_SECRET=test_jwt_secret_123
TEST_ENCRYPTION_KEY=test_encryption_key_32_chars_long

# Redis Configuration
TEST_REDIS_PASSWORD=test_redis_123
TEST_REDIS_HOST=test-redis
TEST_REDIS_PORT=6379

# Testing Configuration
TEST_DATA_PATH=/tmp/test_data
TEST_FIXTURES_PATH=/app/tests/fixtures
TEST_OUTPUT_PATH=/tmp/test_output
TEST_TIMEOUT=300
TEST_PARALLEL_WORKERS=4

# Feature Flags for Testing
TEST_DEBUG_MODE=true
TEST_VERBOSE_LOGGING=true
TEST_MOCK_EXTERNAL_APIS=true
TEST_SKIP_INTEGRATION=false

# Performance Testing
TEST_LOAD_USERS=100
TEST_RAMP_UP_TIME=60
TEST_TEST_DURATION=300

# Security Testing
TEST_VULNERABILITY_SCAN=true
TEST_PENETRATION_TEST=false

# Browser Testing
TEST_BROWSER=chrome
TEST_HEADLESS=true
TEST_SCREEN_WIDTH=1920
TEST_SCREEN_HEIGHT=1080

# Coverage Reporting
TEST_COVERAGE_MIN=80
TEST_COVERAGE_REPORTS=/tmp/coverage
TEST_COVERAGE_FORMAT=html,xml,json