# Multi-stage build pour optimiser la taille
FROM python:3.11-slim AS builder

# Installer les dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    libpq-dev \
    # Audio processing libraries
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    libsamplerate0-dev \
    libtag1-dev \
    libchromaprint-dev \
    libfftw3-dev \
    libyaml-dev \
    # Essentia dependencies
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Créer un virtualenv
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copier et installer les dépendances Python
COPY requirements.txt requirements-production.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-production.txt

# Stage final
FROM python:3.11-slim

# Installer les dépendances runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    # Audio/video runtime libraries
    libavcodec61 \
    libavformat61 \
    libavutil59 \
    libswresample5 \
    libsamplerate0 \
    libtag1v5 \
    libchromaprint1 \
    libfftw3-3 \
    libyaml-0-2 \
    libeigen3-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copier le virtualenv depuis builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Variables d'environnement pour désactiver ALSA et audio
ENV ALSA_CARD=-1 \
    SDL_AUDIODRIVER=dummy \
    AUDIODEV=null \
    PYGAME_HIDE_SUPPORT_PROMPT=1 \
    MPLCONFIGDIR=/tmp/matplotlib

# Créer un utilisateur non-root
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app /app/models && \
    chown -R appuser:appuser /app

WORKDIR /app

# Copier TOUT le code nécessaire (en excluant ce qui est inutile via .dockerignore)
COPY --chown=appuser:appuser . ./

USER appuser

# Exposer le port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/api/health || exit 1

# Commande de démarrage (2 workers optimisé pour GKE avec 2 CPU cores)
CMD ["/opt/venv/bin/python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
