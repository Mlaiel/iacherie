# Development Environment Configuration Template
# Copy this file to .env.development and customize for local development
# 
# Ainflue Platform - Development Environment
# Author: Fahed Mlaiel (mlaiel@live.de)
# Version: 1.0.0

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================

# Application Settings
APP_NAME=Ainflue-Dev
APP_VERSION=1.0.0-dev
APP_DESCRIPTION="AI-Powered Content Protection & Monetization Platform (Development)"
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# API Configuration
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Configuration (permissive for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# PostgreSQL Primary Database (Local Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ainflue_dev
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=ainflue_development

# Redis Cache Database (Local Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB Document Database (Local Development)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=ainflue_dev
MONGODB_PASSWORD=dev_password_123
MONGODB_DB=ainflue_documents_dev

# =================================================================
# SECURITY CONFIGURATION (DEVELOPMENT ONLY - NOT FOR PRODUCTION)
# =================================================================

# JWT Configuration (Development keys - NOT secure)
JWT_SECRET_KEY=dev_jwt_secret_key_not_for_production_use_only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=7200  # 2 hours for development
JWT_REFRESH_TOKEN_EXPIRE=604800

# Encryption Configuration (Development keys - NOT secure)
ENCRYPTION_KEY=dev_encryption_key_not_for_production_use_only
PASSWORD_SALT=dev_salt_123

# OAuth2 Configuration (Development/Test credentials)
OAUTH2_GOOGLE_CLIENT_ID=your_google_dev_client_id.apps.googleusercontent.com
OAUTH2_GOOGLE_CLIENT_SECRET=dev_google_client_secret
OAUTH2_GITHUB_CLIENT_ID=your_github_dev_client_id
OAUTH2_GITHUB_CLIENT_SECRET=dev_github_client_secret

# Rate Limiting (Relaxed for development)
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=3600

# =================================================================
# AI & MACHINE LEARNING CONFIGURATION
# =================================================================

# AI Service Configuration (Use test keys or mock services)
HUGGINGFACE_TOKEN=hf_your_development_token_here
OPENAI_API_KEY=sk-your_development_api_key_here

# Content Processing Limits (Smaller for development)
MAX_FILE_SIZE_MB=50
SUPPORTED_AUDIO_FORMATS=mp3,wav,flac
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif
SUPPORTED_TEXT_FORMATS=txt,md,pdf

# Vector Database Configuration
FAISS_INDEX_PATH=./data/faiss_indexes_dev
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.80  # Lower threshold for development

# =================================================================
# PLATFORM INTEGRATIONS (TEST/SANDBOX ACCOUNTS)
# =================================================================

# YouTube Integration (Development API Key)
YOUTUBE_API_KEY=AIzaSy_your_youtube_dev_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_dev_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=dev_youtube_client_secret

# Instagram Integration (Development/Test Account)
INSTAGRAM_ACCESS_TOKEN=IGQVJy_your_instagram_dev_access_token_here
INSTAGRAM_CLIENT_ID=your_instagram_dev_client_id
INSTAGRAM_CLIENT_SECRET=dev_instagram_client_secret

# TikTok Integration (Development API)
TIKTOK_API_KEY=your_tiktok_dev_api_key_here
TIKTOK_CLIENT_ID=your_tiktok_dev_client_id
TIKTOK_CLIENT_SECRET=dev_tiktok_client_secret

# Spotify Integration (Development App)
SPOTIFY_CLIENT_ID=your_spotify_dev_client_id
SPOTIFY_CLIENT_SECRET=dev_spotify_client_secret

# Twitter/X Integration (Development App)
TWITTER_API_KEY=your_twitter_dev_api_key
TWITTER_API_SECRET=dev_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_dev_access_token
TWITTER_ACCESS_SECRET=dev_twitter_access_secret

# =================================================================
# PAYMENT PROCESSING (TEST/SANDBOX ONLY)
# =================================================================

# Stripe Configuration (TEST KEYS ONLY)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_test_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_test_secret_here

# PayPal Configuration (SANDBOX ONLY)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Wise Configuration (TEST ENVIRONMENT)
WISE_API_KEY=your_wise_test_api_key_here
WISE_ENVIRONMENT=sandbox

# =================================================================
# CLOUD STORAGE (DEVELOPMENT)
# =================================================================

# AWS S3 Configuration (Development bucket)
AWS_ACCESS_KEY_ID=AKIA_your_aws_dev_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_dev_secret_access_key_here
AWS_REGION=eu-central-1
AWS_S3_BUCKET=ainflue-content-development

# CDN Configuration (Optional for development)
CDN_BASE_URL=

# Local Storage (Primary for development)
LOCAL_STORAGE_PATH=./storage

# =================================================================
# MONITORING & OBSERVABILITY (DEVELOPMENT)
# =================================================================

# Prometheus Configuration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=text  # Easier to read in development

# Sentry Configuration (Optional for development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =================================================================
# EMAIL & NOTIFICATIONS (DEVELOPMENT)
# =================================================================

# SMTP Configuration (Use services like MailHog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Email Settings
FROM_EMAIL=dev@ainflue.local
FROM_NAME=Ainflue Development
ADMIN_EMAIL=dev@localhost

# =================================================================
# DEVELOPMENT-SPECIFIC SETTINGS
# =================================================================

# Hot Reloading
AUTO_RELOAD=true
WATCH_FILES=true

# Mock External Services
MOCK_PAYMENT_SERVICES=true
MOCK_AI_SERVICES=false
MOCK_PLATFORM_APIS=false

# Database Auto-migration
AUTO_MIGRATE=true
CREATE_SAMPLE_DATA=true

# Security (Relaxed for development)
FORCE_HTTPS=false
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false

# =================================================================
# PERFORMANCE CONFIGURATION (DEVELOPMENT)
# =================================================================

# Cache Settings (Short TTL for development)
CACHE_TTL=60
CACHE_MAX_SIZE=100

# Database Connection Pool (Smaller for development)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# Request Timeout (Longer for debugging)
REQUEST_TIMEOUT=60
WORKER_TIMEOUT=300

# =================================================================
# TESTING CONFIGURATION
# =================================================================

# Test Database
TEST_DATABASE_URL=sqlite:///./test_ainflue.db

# Test Settings
TESTING=false
DISABLE_AUTH_FOR_TESTING=false
MOCK_EXTERNAL_CALLS=true

# =================================================================
# FEATURE FLAGS (DEVELOPMENT)
# =================================================================

# Feature Toggles (All enabled for development testing)
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_MULTI_CURRENCY=true
FEATURE_COLLABORATION=true
FEATURE_ENTERPRISE_FEATURES=true

# Beta Features (Enable for testing)
BETA_VOICE_RECOGNITION=true
BETA_VIDEO_ANALYSIS=true
BETA_BLOCKCHAIN_INTEGRATION=false

# Development Features
DEV_FEATURE_API_DOCS=true
DEV_FEATURE_ADMIN_PANEL=true
DEV_FEATURE_DEBUG_TOOLBAR=true

# =================================================================
# DEVELOPMENT TOOLS
# =================================================================

# Code Formatting
ENABLE_BLACK_FORMATTING=true
ENABLE_ISORT_IMPORTS=true

# Linting
ENABLE_FLAKE8_LINTING=true
ENABLE_MYPY_CHECKING=true

# Documentation
AUTO_GENERATE_DOCS=true
INCLUDE_EXAMPLE_REQUESTS=true

# =================================================================
# LOCAL DEVELOPMENT SHORTCUTS
# =================================================================

# Quick Setup
SKIP_INITIAL_SETUP=false
USE_SAMPLE_DATA=true
ENABLE_DEMO_MODE=true

# Development Utilities
ENABLE_SQL_ECHO=false  # Set to true to see all SQL queries
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_PROFILING=false

# =================================================================
# DOCKER DEVELOPMENT
# =================================================================

# Docker Compose Services
USE_DOCKER_DATABASES=true
DOCKER_POSTGRES_PORT=5432
DOCKER_REDIS_PORT=6379
DOCKER_MONGODB_PORT=27017

# Volume Mounts
DOCKER_CODE_VOLUME=./:/app
DOCKER_DATA_VOLUME=./data:/app/data

# =================================================================
# API DEVELOPMENT
# =================================================================

# API Documentation
OPENAPI_TITLE=Ainflue Development API
OPENAPI_DESCRIPTION=AI-Powered Content Protection & Monetization Platform API (Development)
OPENAPI_VERSION=1.0.0-dev

# Interactive Documentation
INCLUDE_SWAGGER_UI=true
INCLUDE_REDOC=true
INCLUDE_OPENAPI_JSON=true

# =================================================================
# DEVELOPMENT NOTES
# =================================================================

# This configuration is for DEVELOPMENT ONLY
# 
# Key differences from production:
# - Debug mode enabled
# - Permissive CORS settings
# - Test/sandbox credentials
# - Local storage instead of cloud
# - Relaxed security settings
# - Enhanced logging
# - Mock services available
# 
# To get started:
# 1. Copy this file to .env.development
# 2. Start local databases: docker-compose up -d
# 3. Install dependencies: pip install -r requirements.txt
# 4. Run migrations: alembic upgrade head
# 5. Start server: python main.py
# 
# For help: mlaiel@live.de
